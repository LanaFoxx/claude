 "code": "\nclass Component extends DCLogic {\n  state = {};\n  subTimer = null;\n  subInit() { return;\n    const st = this.state.subState || {};\n    if (localStorage.getItem('tcf_sub_dismissed') || localStorage.getItem('tcf_sub_done')) return;\n    this.subTimer = setTimeout(() => this.setState({ subOpen: true }), 30000);\n  }\n  subVals() {\n    return {\n      subOpen: !!this.state.subOpen, subDone: !!this.state.subDone, subPending: !this.state.subDone, subEmail: this.state.subEmail || '',\n      subChange: ev => this.setState({ subEmail: ev.target.value }),\n      subClose: () => { localStorage.setItem('tcf_sub_dismissed', String(Date.now())); this.setState({ subOpen: false }); },\n      subSubmit: ev => { ev.preventDefault(); localStorage.setItem('tcf_sub_done', '1'); this.setState({ subDone: true }); setTimeout(() => this.setState({ subOpen: false }), 2500); }\n    };\n  }\n  componentDidMount() { this.subInit(); }\n  componentWillUnmount() { clearTimeout(this.subTimer); }\n  renderVals() { return { ...this.subVals() }; }\n}\n",
