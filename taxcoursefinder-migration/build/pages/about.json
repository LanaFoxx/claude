 "widget": "<div class=\"tcf-page tcf-scope tcf-p-about\"><div id=\"tcf-about-root\" class=\"tcf-root\">@@SSR@@</div></div>\n<template id=\"tcf-about-tpl\">\n\n\n<div data-screen-label=\"About\" class=\"tcf-screen\">\n  \n  <div style=\"position:relative;overflow:hidden;color:#fff;padding:110px 56px 100px\">\n    <img src=\"@@MEDIA:photos/05-tax-study-workspace-titled.png@@\" alt=\"\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover\"><div style=\"position:absolute;inset:0;background:linear-gradient(100deg,rgba(11,46,64,.96) 0%,rgba(11,46,64,.88) 55%,rgba(11,46,64,.78) 100%)\"></div>\n    <div style=\"position:relative;z-index:1;max-width:1200px;margin:0 auto\"><div style=\"display:flex;flex-direction:column;gap:22px;max-width:820px\">\n      <span style=\"align-self:flex-start;border:1px solid rgba(108,190,69,.5);color:#95AB3B;border-radius:999px;padding:7px 14px;font:700 17px Manrope,sans-serif;letter-spacing:.1em;text-transform:uppercase\">About</span>\n      <h1 style=\"margin:0;font:300 64px/1.05 Manrope,sans-serif;letter-spacing:-.03em\"><span style=\"display:block\">The directory for</span><span style=\"display:block;font-weight:800\">California <span style=\"color:#95AB3B\">tax education</span></span></h1>\n      <p style=\"margin:0;font-size:22px;line-height:1.55;color:rgba(255,255,255,.82);max-width:640px;text-wrap:pretty\">California Tax Course Finder lists every CTEC-approved education provider and compares them on price, course format and current offers.</p>\n    </div></div>\n  </div>\n  <div style=\"height:6px;background:linear-gradient(90deg,#95AB3B,#7E9330)\"></div>\n  <div style=\"background:#F4F6F7;padding:88px 56px\">\n    <div style=\"max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start\">\n      <div style=\"display:flex;flex-direction:column;gap:18px;font-size:22px;line-height:1.65;color:#2F4652\">\n        <h2 style=\"margin:0;font:800 34px/1.15 Manrope,sans-serif;letter-spacing:-.02em;color:#0B2E40\">Why we built this</h2>\n        <p style=\"margin:0\">Every year, tens of thousands of California tax preparers have to pick a CTEC course. The required hours are the same everywhere, so the choice comes down to details providers don't make easy to compare: what the course really costs after coupons and add-ons, how fast hours get reported, whether there's a book, whether support is available when you study.</p>\n        <p style=\"margin:0\">We put every approved provider on one page, side by side, with the same facts checked the same way. Every approved school appears, and every profile can be verified and corrected for free.</p>\n        </div>\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:16px\">\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:28px\"><div style=\"font:800 52px/1 Manrope,sans-serif;color:#7E9330;letter-spacing:-.03em\">{{ total }}</div><div style=\"font:700 22px Manrope,sans-serif;margin-top:10px\">Providers listed</div><div style=\"font-size:19px;color:#5A6E78;margin-top:4px\">{{ ceTotal }} offer the 20-hour course · {{ qeTotal }} offer the 60-hour course.</div></div>\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:28px\"><div style=\"font:800 52px/1 Manrope,sans-serif;color:#7E9330;letter-spacing:-.03em;font-size:26px\">{{ lastChecked }}</div><div style=\"font:700 22px Manrope,sans-serif;margin-top:10px\">Data last checked</div><div style=\"font-size:19px;color:#5A6E78;margin-top:4px\">Prices and offers re-checked on each review.</div></div>\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:28px\"><div style=\"font:800 52px/1 Manrope,sans-serif;color:#7E9330;letter-spacing:-.03em\">{{ featureCount }}</div><div style=\"font:700 22px Manrope,sans-serif;margin-top:10px\">Course features tracked</div><div style=\"font-size:19px;color:#5A6E78;margin-top:4px\">Shown once verified with the provider.</div></div>\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:28px\"><div style=\"font:800 52px/1 Manrope,sans-serif;color:#7E9330;letter-spacing:-.03em\">$0</div><div style=\"font:700 22px Manrope,sans-serif;margin-top:10px\">To be listed or corrected</div><div style=\"font-size:19px;color:#5A6E78;margin-top:4px\">Basic listings and factual fixes are free.</div></div>\n      </div>\n    </div>\n  </div>\n  <div id=\"contact\" style=\"background:#fff;padding:88px 56px;scroll-margin-top:120px\">\n    <div style=\"max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px\">\n      <div style=\"border:1px solid #D7DFE2;border-radius:16px;padding:32px;display:flex;flex-direction:column;gap:10px\"><div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">Students</div><div style=\"font:800 22px Manrope,sans-serif\">Questions or feedback</div><a href=\"mailto:hello@taxcoursefinder.com\" style=\"font:700 22px ui-monospace,Menlo,monospace\">hello@taxcoursefinder.com</a></div>\n      <div style=\"border:1px solid #D7DFE2;border-radius:16px;padding:32px;display:flex;flex-direction:column;gap:10px\"><div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">Providers</div><div style=\"font:800 22px Manrope,sans-serif\">Listings and corrections</div><a href=\"mailto:providers@taxcoursefinder.com\" style=\"font:700 22px ui-monospace,Menlo,monospace\">providers@taxcoursefinder.com</a></div>\n      <div style=\"border:1px solid #D7DFE2;border-radius:16px;padding:32px;display:flex;flex-direction:column;gap:10px\"><div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">Press</div><div style=\"font:800 22px Manrope,sans-serif\">Media and data requests</div><a href=\"mailto:press@taxcoursefinder.com\" style=\"font:700 22px ui-monospace,Menlo,monospace\">press@taxcoursefinder.com</a></div>\n    </div>\n  </div>\n  \n</div>\n  <sc-if value=\"{{ subOpen }}\" hint-placeholder-val=\"{{ false }}\">\n  <div style=\"position:fixed;right:24px;bottom:24px;z-index:80;width:380px;max-width:calc(100vw - 32px);background:#fff;border:1px solid #D7DFE2;border-radius:18px;box-shadow:0 30px 70px rgba(11,46,64,.28);overflow:hidden;font-family:'Source Sans 3',sans-serif;color:#0B2E40\">\n    <div style=\"height:5px;background:#95AB3B\"></div>\n    <div onclick=\"{{ subClose }}\" title=\"Close\" style=\"position:absolute;top:14px;right:12px;width:36px;height:36px;display:grid;place-items:center;border-radius:8px;cursor:pointer;color:#5A6E78\" data-hv=\"7\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M6 6l12 12M18 6L6 18\"></path></svg></div>\n    <div style=\"padding:26px 26px 24px;display:flex;flex-direction:column;gap:14px\">\n      <div style=\"font:700 15px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">Monthly coupon codes</div>\n      <div style=\"font:800 26px/1.15 Manrope,sans-serif;letter-spacing:-.01em;padding-right:24px\">Get CTEC course coupon codes every month</div>\n      <p style=\"margin:0;font-size:17px;line-height:1.5;color:#5A6E78\">New codes from different course providers each month, plus an alert when a sale starts. No spam, unsubscribe anytime.</p>\n      <sc-if value=\"{{ subDone }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"background:#F3F5E6;border:1px solid #D7EDC8;border-radius:10px;padding:14px 16px;font:700 17px Manrope,sans-serif;color:#7E9330\">You're in. Watch for this month's codes.</div></sc-if>\n      <sc-if value=\"{{ subPending }}\" hint-placeholder-val=\"{{ true }}\">\n      <form onsubmit=\"{{ subSubmit }}\" style=\"display:flex;flex-direction:column;gap:10px\">\n        <input type=\"email\" required=\"\" value=\"{{ subEmail }}\" onchange=\"{{ subChange }}\" placeholder=\"you@example.com\" style=\"height:50px;border:1px solid #D7DFE2;border-radius:10px;padding:0 16px;font:400 17px 'Source Sans 3',sans-serif;color:#0B2E40;outline:none;width:100%;box-sizing:border-box\">\n        <button type=\"submit\" style=\"height:50px;border:0;border-radius:10px;background:#95AB3B;color:#fff;font:700 17px Manrope,sans-serif;cursor:pointer\" data-hv=\"6\">Send me the codes</button>\n      </form>\n      </sc-if>\n      <div style=\"font-size:15px;color:#8A9AA3\">By subscribing you agree to our <a href=\"/privacy-policy/\" style=\"color:#7E9330;font-weight:700\">Privacy Policy</a>.</div>\n    </div>\n  </div>\n  </sc-if>\n</template>\n<script>(function(){var root=document.getElementById(\"tcf-about-root\"),tpl=document.getElementById(\"tcf-about-tpl\");var C=(function(){\nclass Component extends DCLogic {\n\n  subTimer = null;\n  subInit() { return;\n    const st = this.state.subState || {};\n    if (localStorage.getItem('tcf_sub_dismissed') || localStorage.getItem('tcf_sub_done')) return;\n    this.subTimer = setTimeout(() => this.setState({ subOpen: true }), 30000);\n  }\n  subVals() {\n    return {\n      subOpen: !!this.state.subOpen, subDone: !!this.state.subDone, subPending: !this.state.subDone, subEmail: this.state.subEmail || '',\n      subChange: ev => this.setState({ subEmail: ev.target.value }),\n      subClose: () => { localStorage.setItem('tcf_sub_dismissed', String(Date.now())); this.setState({ subOpen: false }); },\n      subSubmit: ev => { ev.preventDefault(); localStorage.setItem('tcf_sub_done', '1'); this.setState({ subDone: true }); setTimeout(() => this.setState({ subOpen: false }), 2500); }\n    };\n  }\n  state = { data: null };\n  async componentDidMount() { this.subInit(); this.setState({ data: await TCF.data() }); }\n  renderVals() {\n    const d = this.state.data; const ps = d ? d.providers : [];\n    const ds = ps.map(p => p.lastChecked).filter(Boolean).sort();\n    const lc = ds.length ? new Date(ds[ds.length - 1]) : null;\n    return { ...this.subVals(), total: ps.length || '', ceTotal: ps.filter(p => p.ce).length || '', qeTotal: ps.filter(p => p.qe).length || '', featureCount: d && d.FEATURES ? d.FEATURES.reduce((n, [, i]) => n + i.length, 0) : '', lastChecked: lc && !isNaN(lc) ? lc.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '' };\n  }\n}\n\nreturn Component;})();function go(){if(typeof useM!==\"undefined\"&&useM){root.parentNode.classList.add(\"tcf-mobile\");TCF.mount(root,document.getElementById(\"tcf-about-mtpl\"),M,{});}else TCF.mount(root,tpl,C,{});}if(!window.TCF||!TCF.mount)return;TCF.data().then(go,go);})();</script>",
 "css": "body{margin:0;background:#fff;font-family:\"Source Sans 3\",system-ui,sans-serif;color:#0B2E40}a{color:#7E9330;text-decoration:none}a:hover{color:#7E9330}a:visited{color:#7E9330}a:active{color:#7E9330}a:focus{outline:none}html{scrollbar-gutter:stable}button,select{font:inherit}button:focus,select:focus,input:focus{outline:none}.dd-menu a{display:flex!important;align-items:center;justify-content:space-between;gap:18px}.dd .dd-menu{display:none}.dd:hover .dd-menu,.dd:focus-within .dd-menu{display:block}",
