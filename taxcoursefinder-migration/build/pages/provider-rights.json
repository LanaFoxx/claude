{
 "code": "\nclass Component extends DCLogic {\n  state = {};\n  subTimer = null;\n  subInit() { return;\n    const st = this.state.subState || {};\n    if (localStorage.getItem('tcf_sub_dismissed') || localStorage.getItem('tcf_sub_done')) return;\n    this.subTimer = setTimeout(() => this.setState({ subOpen: true }), 30000);\n  }\n  subVals() {\n    return {\n      subOpen: !!this.state.subOpen, subDone: !!this.state.subDone, subPending: !this.state.subDone, subEmail: this.state.subEmail || '',\n      subChange: ev => this.setState({ subEmail: ev.target.value }),\n      subClose: () => { localStorage.setItem('tcf_sub_dismissed', String(Date.now())); this.setState({ subOpen: false }); },\n      subSubmit: ev => { ev.preventDefault(); localStorage.setItem('tcf_sub_done', '1'); this.setState({ subDone: true }); setTimeout(() => this.setState({ subOpen: false }), 2500); }\n    };\n  }\n  componentDidMount() { this.subInit(); }\n  componentWillUnmount() { clearTimeout(this.subTimer); }\n  renderVals() { return { ...this.subVals() }; }\n}\n",
 "props": {},
 "name": "Provider Rights",
 "slug": "provider-rights",
 "url": "/provider-rights/",
 "title": "Provider Profile Rights & Accuracy",
 "runtime": false,
 "rid": "tcf-provider-rights",
 "widget": "<div class=\"tcf-page tcf-scope tcf-p-provider-rights\"><div id=\"tcf-provider-rights-root\" class=\"tcf-root\">@@SSR@@</div></div>\n<template id=\"tcf-provider-rights-tpl\">\n\n\n<div data-screen-label=\"Provider Rights\" class=\"tcf-screen\">\n  \n\n  <div style=\"position:relative;overflow:hidden;color:#fff;padding:110px 56px 100px\">\n    <img src=\"@@MEDIA:photos/ctec-renewal-records.webp@@\" alt=\"\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover\"><div style=\"position:absolute;inset:0;background:linear-gradient(100deg,rgba(11,46,64,.96) 0%,rgba(11,46,64,.88) 55%,rgba(11,46,64,.78) 100%)\"></div>\n    <div style=\"position:relative;z-index:1;max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:center\">\n      <div style=\"display:flex;flex-direction:column;gap:20px\">\n        <span style=\"align-self:flex-start;border:1px solid rgba(108,190,69,.5);color:#95AB3B;border-radius:999px;padding:7px 14px;font:700 17px Manrope,sans-serif;letter-spacing:.1em;text-transform:uppercase\">For education providers</span>\n        <h1 style=\"margin:0;font:300 64px/1.05 Manrope,sans-serif;letter-spacing:-.02em\"><span style=\"display:block\">Provider Profile</span><span style=\"display:block;font-weight:800\">Rights <span style=\"color:#95AB3B\">&amp;</span> Accuracy</span></h1>\n        <p style=\"margin:0;font:600 26px/1.35 Manrope,sans-serif;text-wrap:pretty\">We Want Every Provider Profile to Be Accurate, Fair and Up to Date.</p>\n        <div style=\"display:flex;gap:12px\"><a href=\"/provider-application/\" style=\"background:#95AB3B;color:#fff;font:700 22px Manrope,sans-serif;padding:14px 24px;border-radius:8px\" data-hv=\"4\">Claim Your Provider Profile</a><a href=\"#correction\" style=\"border:1.5px solid rgba(255,255,255,.4);color:#fff;font:700 22px Manrope,sans-serif;padding:13px 24px;border-radius:8px\" data-hv=\"20\">Request a Correction</a></div>\n      </div>\n      <div style=\"display:flex;flex-direction:column;gap:14px;font-size:22px;line-height:1.6;color:rgba(255,255,255,.82);text-wrap:pretty;border-left:2px solid rgba(108,190,69,.5);padding-left:28px\">\n        <p style=\"margin:0\">California Tax Course Finder is designed to help California tax professionals make informed decisions when choosing an education provider.</p>\n        <p style=\"margin:0\">We also believe every tax education provider represented on our platform deserves to have its company, courses, pricing, policies, and services represented accurately.</p>\n        <p style=\"margin:0;color:#fff;font-weight:600\">If your company appears on California Tax Course Finder, you have the right to notify us of inaccurate or outdated factual information at any time.</p>\n      </div>\n    </div>\n  </div>\n  <div style=\"height:6px;background:linear-gradient(90deg,#95AB3B,#7E9330)\"></div>\n\n  <!-- LISTING VS VERIFICATION -->\n  <div style=\"background:#F4F6F7;padding:56px 56px 0\">\n    <div style=\"max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:20px\">\n      <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:32px;display:flex;flex-direction:column;gap:12px\"><div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">Listing and verification are separate</div><p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">California Tax Course Finder may independently create provider profiles using publicly available factual information. Providers are not required to participate in or verify their profile in order to be included.</p><p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">Providers may submit factual corrections and updates at any time at no charge.</p></div>\n      <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:32px;display:flex;flex-direction:column;gap:12px\"><div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">Email preferences and profiles are separate</div><p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">Providers may unsubscribe from promotional email communications at any time. An email opt-out does not constitute a request to modify or remove a provider's directory profile.</p><p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">To report inaccurate information, use <a href=\"#correction\" style=\"font-weight:700\">Request a Correction</a>.</p></div>\n    </div>\n  </div>\n\n  <!-- YOUR RIGHTS -->\n  <div style=\"background:#F4F6F7;padding:56px 56px 24px\">\n    <div style=\"max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:24px\">\n      <div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">Your rights as a provider</div>\n      <div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;align-items:start\">\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:32px;display:flex;flex-direction:column;gap:14px;box-shadow:0 2px 8px rgba(11,46,64,.06)\">\n          <div style=\"font:800 19px Manrope,sans-serif;color:#7E9330\">01</div>\n          <h3 style=\"margin:0;font:800 26px/1.2 Manrope,sans-serif;letter-spacing:-.01em\">Your Right to Correct Factual Errors</h3>\n          <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">If information displayed on your company profile is factually incorrect, you may request a correction.</p>\n          <div style=\"font:700 19px Manrope,sans-serif;color:#5A6E78\">This includes information such as:</div>\n          <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:6px 12px;font-size:19px;color:#2F4652;line-height:1.4\"><span>Course pricing</span><span>Available courses</span><span>CTEC approval information</span><span>Company contact information</span><span>Website URLs</span><span>Course delivery formats</span><span>Included features</span><span>Customer support options</span><span>Refund policies</span><span>Course completion procedures</span><span>Certificate information</span><span>Promotional offers</span><span>Coupon codes</span><span>Business hours</span></div>\n          <div style=\"margin-top:auto;background:#F3F5E6;border-radius:8px;padding:12px 14px;font:700 19px Manrope,sans-serif;color:#7E9330\">There is no fee to correct factual inaccuracies.</div>\n        </div>\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:32px;display:flex;flex-direction:column;gap:14px;box-shadow:0 2px 8px rgba(11,46,64,.06)\">\n          <div style=\"font:800 19px Manrope,sans-serif;color:#7E9330\">02</div>\n          <h3 style=\"margin:0;font:800 26px/1.2 Manrope,sans-serif;letter-spacing:-.01em\">Your Right to Update Your Profile</h3>\n          <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">Providers may submit updated information whenever their products or services change.</p>\n          <div style=\"font:700 19px Manrope,sans-serif;color:#5A6E78\">For example, if you:</div>\n          <div style=\"display:flex;flex-direction:column;gap:6px;font-size:19px;color:#2F4652;line-height:1.4\"><span>launch a new course,</span><span>discontinue a course,</span><span>change your pricing,</span><span>introduce a new discount,</span><span>update your learning platform,</span><span>add live support,</span><span>change your refund policy,</span><span>introduce a mobile application,</span><span>or make another material change,</span></div>\n          <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">you may submit the updated information to California Tax Course Finder for review.</p>\n          <a href=\"/provider-application/\" style=\"margin-top:auto;display:block;text-align:center;background:#0B2E40;color:#fff;font:700 19px Manrope,sans-serif;padding:12px;border-radius:8px\" data-hv=\"10\">Request a Profile Update</a>\n        </div>\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:32px;display:flex;flex-direction:column;gap:14px;box-shadow:0 2px 8px rgba(11,46,64,.06)\">\n          <div style=\"font:800 19px Manrope,sans-serif;color:#7E9330\">03</div>\n          <h3 style=\"margin:0;font:800 26px/1.2 Manrope,sans-serif;letter-spacing:-.01em\">Your Right to Provide Supporting Information</h3>\n          <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">If you believe information on your profile is incomplete or misleading because important context is missing, you may provide supporting documentation or an explanation.</p>\n          <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">Our team will review relevant materials and make appropriate factual corrections when warranted.</p>\n          <div style=\"font:700 19px Manrope,sans-serif;color:#5A6E78\">Supporting materials may include:</div>\n          <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:6px 12px;font-size:19px;color:#2F4652;line-height:1.4\"><span>Website pages</span><span>Course catalogs</span><span>Screenshots</span><span>Pricing documents</span><span>CTEC information</span><span>Policies</span><span>Product documentation</span><span>Customer support information</span></div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- CLAIM + CANNOT CHANGE -->\n  <div id=\"claim\" style=\"background:#F4F6F7;padding:0 56px 72px;scroll-margin-top:120px\">\n    <div style=\"max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:24px\">\n      <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:36px;display:flex;flex-direction:column;gap:14px;box-shadow:0 2px 8px rgba(11,46,64,.06)\">\n        <h3 style=\"margin:0;font:800 26px/1.2 Manrope,sans-serif;letter-spacing:-.01em\">Claiming Your Provider Profile</h3>\n        <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">If your company is already listed on California Tax Course Finder, an authorized representative may request access to manage or submit updates to certain factual information.</p>\n        <div style=\"font:700 19px Manrope,sans-serif;color:#5A6E78\">Claiming a profile may allow providers to submit updates regarding:</div>\n        <div style=\"display:flex;flex-wrap:wrap;gap:8px;font:600 19px Manrope,sans-serif;color:#2F4652\"><span style=\"background:#F4F6F7;border-radius:6px;padding:6px 10px\">Pricing</span><span style=\"background:#F4F6F7;border-radius:6px;padding:6px 10px\">Course offerings</span><span style=\"background:#F4F6F7;border-radius:6px;padding:6px 10px\">Company description</span><span style=\"background:#F4F6F7;border-radius:6px;padding:6px 10px\">Support information</span><span style=\"background:#F4F6F7;border-radius:6px;padding:6px 10px\">Coupon codes</span><span style=\"background:#F4F6F7;border-radius:6px;padding:6px 10px\">Logos</span><span style=\"background:#F4F6F7;border-radius:6px;padding:6px 10px\">Website links</span><span style=\"background:#F4F6F7;border-radius:6px;padding:6px 10px\">Course features</span><span style=\"background:#F4F6F7;border-radius:6px;padding:6px 10px\">Promotional offers</span></div>\n        <a href=\"/provider-application/\" style=\"margin-top:auto;display:block;text-align:center;background:#95AB3B;color:#fff;font:700 22px Manrope,sans-serif;padding:14px;border-radius:8px\" data-hv=\"4\">Claim Your Provider Profile</a>\n      </div>\n      <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:36px;display:flex;flex-direction:column;gap:14px;box-shadow:0 2px 8px rgba(11,46,64,.06)\">\n        <h3 style=\"margin:0;font:800 26px/1.2 Manrope,sans-serif;letter-spacing:-.01em\">What Providers Cannot Change</h3>\n        <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">Providers generally cannot demand changes to:</p>\n        <div style=\"display:flex;flex-direction:column;gap:10px;font-size:22px;line-height:1.5;color:#2F4652\">\n          <div style=\"display:flex;gap:10px\"><span style=\"color:#C0392B;font-weight:700;flex:none\">–</span>Published comparisons supported by accurate information</div>\n        </div>\n        <p style=\"margin:0;font-size:22px;line-height:1.6;color:#5A6E78;border-top:1px solid #E3E9EB;padding-top:14px\">This does not prevent a provider from notifying us when the underlying information is incorrect.</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- CORRECTION -->\n  <div id=\"correction\" style=\"background:#fff;padding:72px 56px;scroll-margin-top:120px\">\n    <div style=\"max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1.2fr;gap:64px;align-items:start\">\n      <div style=\"display:flex;flex-direction:column;gap:16px\">\n        <div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">How to Request a Correction</div>\n        <h2 style=\"margin:0;font:800 52px/1.1 Manrope,sans-serif;letter-spacing:-.02em\">Something Wrong?</h2>\n        <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">Send us the details below and our team will review them. Everything funnels through one address:</p>\n        <a href=\"mailto:providers@taxcoursefinder.com\" style=\"display:inline-flex;align-self:flex-start;align-items:center;gap:10px;background:#F3F5E6;border:1.5px dashed #95AB3B;color:#7E9330;font:700 22px ui-monospace,Menlo,monospace;padding:12px 16px;border-radius:8px\">providers@taxcoursefinder.com</a>\n        <a href=\"mailto:providers@taxcoursefinder.com\" style=\"display:inline-block;align-self:flex-start;background:#0B2E40;color:#fff;font:700 22px Manrope,sans-serif;padding:14px 24px;border-radius:8px\" data-hv=\"10\">Request a Correction</a>\n      </div>\n      <div style=\"background:#F4F6F7;border-radius:16px;padding:32px 36px\">\n        <div style=\"font:700 22px Manrope,sans-serif;margin-bottom:18px\">Send us:</div>\n        <div style=\"display:flex;flex-direction:column;gap:12px;font-size:22px;color:#2F4652\">\n          <div style=\"display:flex;gap:14px;align-items:center\"><span style=\"width:28px;height:28px;border-radius:8px;background:#0B2E40;color:#fff;display:grid;place-items:center;font:800 19px Manrope,sans-serif;flex:none\">1</span>Company name</div>\n          <div style=\"display:flex;gap:14px;align-items:center\"><span style=\"width:28px;height:28px;border-radius:8px;background:#0B2E40;color:#fff;display:grid;place-items:center;font:800 19px Manrope,sans-serif;flex:none\">2</span>Your name and position</div>\n          <div style=\"display:flex;gap:14px;align-items:center\"><span style=\"width:28px;height:28px;border-radius:8px;background:#0B2E40;color:#fff;display:grid;place-items:center;font:800 19px Manrope,sans-serif;flex:none\">3</span>The page containing the information</div>\n          <div style=\"display:flex;gap:14px;align-items:center\"><span style=\"width:28px;height:28px;border-radius:8px;background:#0B2E40;color:#fff;display:grid;place-items:center;font:800 19px Manrope,sans-serif;flex:none\">4</span>What information you believe is incorrect</div>\n          <div style=\"display:flex;gap:14px;align-items:center\"><span style=\"width:28px;height:28px;border-radius:8px;background:#0B2E40;color:#fff;display:grid;place-items:center;font:800 19px Manrope,sans-serif;flex:none\">5</span>The correct information</div>\n          <div style=\"display:flex;gap:14px;align-items:center\"><span style=\"width:28px;height:28px;border-radius:8px;background:#0B2E40;color:#fff;display:grid;place-items:center;font:800 19px Manrope,sans-serif;flex:none\">6</span>Supporting documentation or URL</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- COMMITMENT -->\n  <div style=\"background:#F4F6F7;padding:80px 56px;color:#0B2E40\">\n    <div style=\"max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:20px\">\n      <div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#2F4652\">Our Accuracy Commitment</div>\n      <h2 style=\"margin:0;font:300 52px/1.1 Manrope,sans-serif;letter-spacing:-.02em;text-wrap:pretty;max-width:900px\">Our goal is simple: <span style=\"font-weight:800\">accurate information and fair comparisons.</span></h2>\n      <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652;max-width:820px\">California Tax Course Finder benefits when students trust the information they find here. Providers benefit when their businesses are represented accurately.</p>\n      <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652;max-width:820px\">When legitimate factual errors are brought to our attention, we will make reasonable efforts to investigate and correct them promptly.</p>\n      <p style=\"margin:0;font:700 22px/1.5 Manrope,sans-serif;color:#0B2E40;border-left:3px solid #0B2E40;padding-left:20px\">Correcting inaccurate factual information is always free.</p>\n    </div>\n  </div>\n\n  \n</div>\n  <sc-if value=\"{{ subOpen }}\" hint-placeholder-val=\"{{ false }}\">\n  <div style=\"position:fixed;right:24px;bottom:24px;z-index:80;width:380px;max-width:calc(100vw - 32px);background:#fff;border:1px solid #D7DFE2;border-radius:18px;box-shadow:0 30px 70px rgba(11,46,64,.28);overflow:hidden;font-family:'Source Sans 3',sans-serif;color:#0B2E40\">\n    <div style=\"height:5px;background:#95AB3B\"></div>\n    <div onclick=\"{{ subClose }}\" title=\"Close\" style=\"position:absolute;top:14px;right:12px;width:36px;height:36px;display:grid;place-items:center;border-radius:8px;cursor:pointer;color:#5A6E78\" data-hv=\"7\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M6 6l12 12M18 6L6 18\"></path></svg></div>\n    <div style=\"padding:26px 26px 24px;display:flex;flex-direction:column;gap:14px\">\n      <div style=\"font:700 15px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">Monthly coupon codes</div>\n      <div style=\"font:800 26px/1.15 Manrope,sans-serif;letter-spacing:-.01em;padding-right:24px\">Get CTEC course coupon codes every month</div>\n      <p style=\"margin:0;font-size:17px;line-height:1.5;color:#5A6E78\">New codes from different course providers each month, plus an alert when a sale starts. No spam, unsubscribe anytime.</p>\n      <sc-if value=\"{{ subDone }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"background:#F3F5E6;border:1px solid #D7EDC8;border-radius:10px;padding:14px 16px;font:700 17px Manrope,sans-serif;color:#7E9330\">You're in. Watch for this month's codes.</div></sc-if>\n      <sc-if value=\"{{ subPending }}\" hint-placeholder-val=\"{{ true }}\">\n      <form onsubmit=\"{{ subSubmit }}\" style=\"display:flex;flex-direction:column;gap:10px\">\n        <input type=\"email\" required=\"\" value=\"{{ subEmail }}\" onchange=\"{{ subChange }}\" placeholder=\"you@example.com\" style=\"height:50px;border:1px solid #D7DFE2;border-radius:10px;padding:0 16px;font:400 17px 'Source Sans 3',sans-serif;color:#0B2E40;outline:none;width:100%;box-sizing:border-box\">\n        <button type=\"submit\" style=\"height:50px;border:0;border-radius:10px;background:#95AB3B;color:#fff;font:700 17px Manrope,sans-serif;cursor:pointer\" data-hv=\"6\">Send me the codes</button>\n      </form>\n      </sc-if>\n      <div style=\"font-size:15px;color:#8A9AA3\">By subscribing you agree to our <a href=\"/privacy-policy/\" style=\"color:#7E9330;font-weight:700\">Privacy Policy</a>.</div>\n    </div>\n  </div>\n  </sc-if>\n</template>",
 "css": "body{margin:0;background:#fff;font-family:\"Source Sans 3\",system-ui,sans-serif;color:#0B2E40}a{color:#7E9330;text-decoration:none}a:hover{color:#7E9330}a:visited{color:#7E9330}a:active{color:#7E9330}a:focus{outline:none}html{scrollbar-gutter:stable}button,select{font:inherit}button:focus,select:focus,input:focus{outline:none}.dd-menu a{display:flex!important;align-items:center;justify-content:space-between;gap:18px}.dd .dd-menu{display:none}.dd:hover .dd-menu,.dd:focus-within .dd-menu{display:block}",
 "ssr": "\n\n\n<div data-screen-label=\"Provider Rights\" class=\"tcf-screen\">\n  \n\n  <div style=\"position:relative;overflow:hidden;color:#fff;padding:110px 56px 100px\">\n    <img src=\"/assets/photos/ctec-renewal-records.webp\" alt=\"\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover\"><div style=\"position:absolute;inset:0;background:linear-gradient(100deg,rgba(11,46,64,.96) 0%,rgba(11,46,64,.88) 55%,rgba(11,46,64,.78) 100%)\"></div>\n    <div style=\"position:relative;z-index:1;max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:center\">\n      <div style=\"display:flex;flex-direction:column;gap:20px\">\n        <span style=\"align-self:flex-start;border:1px solid rgba(108,190,69,.5);color:#95AB3B;border-radius:999px;padding:7px 14px;font:700 17px Manrope,sans-serif;letter-spacing:.1em;text-transform:uppercase\">For education providers</span>\n        <h1 style=\"margin:0;font:300 64px/1.05 Manrope,sans-serif;letter-spacing:-.02em\"><span style=\"display:block\">Provider Profile</span><span style=\"display:block;font-weight:800\">Rights <span style=\"color:#95AB3B\">&amp;</span> Accuracy</span></h1>\n        <p style=\"margin:0;font:600 26px/1.35 Manrope,sans-serif;text-wrap:pretty\">We Want Every Provider Profile to Be Accurate, Fair and Up to Date.</p>\n        <div style=\"display:flex;gap:12px\"><a href=\"/provider-application/\" style=\"background:#95AB3B;color:#fff;font:700 22px Manrope,sans-serif;padding:14px 24px;border-radius:8px\" data-hv=\"4\">Claim Your Provider Profile</a><a href=\"#correction\" style=\"border:1.5px solid rgba(255,255,255,.4);color:#fff;font:700 22px Manrope,sans-serif;padding:13px 24px;border-radius:8px\" data-hv=\"20\">Request a Correction</a></div>\n      </div>\n      <div style=\"display:flex;flex-direction:column;gap:14px;font-size:22px;line-height:1.6;color:rgba(255,255,255,.82);text-wrap:pretty;border-left:2px solid rgba(108,190,69,.5);padding-left:28px\">\n        <p style=\"margin:0\">California Tax Course Finder is designed to help California tax professionals make informed decisions when choosing an education provider.</p>\n        <p style=\"margin:0\">We also believe every tax education provider represented on our platform deserves to have its company, courses, pricing, policies, and services represented accurately.</p>\n        <p style=\"margin:0;color:#fff;font-weight:600\">If your company appears on California Tax Course Finder, you have the right to notify us of inaccurate or outdated factual information at any time.</p>\n      </div>\n    </div>\n  </div>\n  <div style=\"height:6px;background:linear-gradient(90deg,#95AB3B,#7E9330)\"></div>\n\n  \n  <div style=\"background:#F4F6F7;padding:56px 56px 0\">\n    <div style=\"max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:20px\">\n      <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:32px;display:flex;flex-direction:column;gap:12px\"><div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">Listing and verification are separate</div><p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">California Tax Course Finder may independently create provider profiles using publicly available factual information. Providers are not required to participate in or verify their profile in order to be included.</p><p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">Providers may submit factual corrections and updates at any time at no charge.</p></div>\n      <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:32px;display:flex;flex-direction:column;gap:12px\"><div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">Email preferences and profiles are separate</div><p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">Providers may unsubscribe from promotional email communications at any time. An email opt-out does not constitute a request to modify or remove a provider's directory profile.</p><p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">To report inaccurate information, use <a href=\"#correction\" style=\"font-weight:700\">Request a Correction</a>.</p></div>\n    </div>\n  </div>\n\n  \n  <div style=\"background:#F4F6F7;padding:56px 56px 24px\">\n    <div style=\"max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:24px\">\n      <div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">Your rights as a provider</div>\n      <div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;align-items:start\">\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:32px;display:flex;flex-direction:column;gap:14px;box-shadow:0 2px 8px rgba(11,46,64,.06)\">\n          <div style=\"font:800 19px Manrope,sans-serif;color:#7E9330\">01</div>\n          <h3 style=\"margin:0;font:800 26px/1.2 Manrope,sans-serif;letter-spacing:-.01em\">Your Right to Correct Factual Errors</h3>\n          <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">If information displayed on your company profile is factually incorrect, you may request a correction.</p>\n          <div style=\"font:700 19px Manrope,sans-serif;color:#5A6E78\">This includes information such as:</div>\n          <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:6px 12px;font-size:19px;color:#2F4652;line-height:1.4\"><span>Course pricing</span><span>Available courses</span><span>CTEC approval information</span><span>Company contact information</span><span>Website URLs</span><span>Course delivery formats</span><span>Included features</span><span>Customer support options</span><span>Refund policies</span><span>Course completion procedures</span><span>Certificate information</span><span>Promotional offers</span><span>Coupon codes</span><span>Business hours</span></div>\n          <div style=\"margin-top:auto;background:#F3F5E6;border-radius:8px;padding:12px 14px;font:700 19px Manrope,sans-serif;color:#7E9330\">There is no fee to correct factual inaccuracies.</div>\n        </div>\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:32px;display:flex;flex-direction:column;gap:14px;box-shadow:0 2px 8px rgba(11,46,64,.06)\">\n          <div style=\"font:800 19px Manrope,sans-serif;color:#7E9330\">02</div>\n          <h3 style=\"margin:0;font:800 26px/1.2 Manrope,sans-serif;letter-spacing:-.01em\">Your Right to Update Your Profile</h3>\n          <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">Providers may submit updated information whenever their products or services change.</p>\n          <div style=\"font:700 19px Manrope,sans-serif;color:#5A6E78\">For example, if you:</div>\n          <div style=\"display:flex;flex-direction:column;gap:6px;font-size:19px;color:#2F4652;line-height:1.4\"><span>launch a new course,</span><span>discontinue a course,</span><span>change your pricing,</span><span>introduce a new discount,</span><span>update your learning platform,</span><span>add live support,</span><span>change your refund policy,</span><span>introduce a mobile application,</span><span>or make another material change,</span></div>\n          <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">you may submit the updated information to California Tax Course Finder for review.</p>\n          <a href=\"/provider-application/\" style=\"margin-top:auto;display:block;text-align:center;background:#0B2E40;color:#fff;font:700 19px Manrope,sans-serif;padding:12px;border-radius:8px\" data-hv=\"10\">Request a Profile Update</a>\n        </div>\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:32px;display:flex;flex-direction:column;gap:14px;box-shadow:0 2px 8px rgba(11,46,64,.06)\">\n          <div style=\"font:800 19px Manrope,sans-serif;color:#7E9330\">03</div>\n          <h3 style=\"margin:0;font:800 26px/1.2 Manrope,sans-serif;letter-spacing:-.01em\">Your Right to Provide Supporting Information</h3>\n          <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">If you believe information on your profile is incomplete or misleading because important context is missing, you may provide supporting documentation or an explanation.</p>\n          <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">Our team will review relevant materials and make appropriate factual corrections when warranted.</p>\n          <div style=\"font:700 19px Manrope,sans-serif;color:#5A6E78\">Supporting materials may include:</div>\n          <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:6px 12px;font-size:19px;color:#2F4652;line-height:1.4\"><span>Website pages</span><span>Course catalogs</span><span>Screenshots</span><span>Pricing documents</span><span>CTEC information</span><span>Policies</span><span>Product documentation</span><span>Customer support information</span></div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  \n  <div id=\"claim\" style=\"background:#F4F6F7;padding:0 56px 72px;scroll-margin-top:120px\">\n    <div style=\"max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:24px\">\n      <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:36px;display:flex;flex-direction:column;gap:14px;box-shadow:0 2px 8px rgba(11,46,64,.06)\">\n        <h3 style=\"margin:0;font:800 26px/1.2 Manrope,sans-serif;letter-spacing:-.01em\">Claiming Your Provider Profile</h3>\n        <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">If your company is already listed on California Tax Course Finder, an authorized representative may request access to manage or submit updates to certain factual information.</p>\n        <div style=\"font:700 19px Manrope,sans-serif;color:#5A6E78\">Claiming a profile may allow providers to submit updates regarding:</div>\n        <div style=\"display:flex;flex-wrap:wrap;gap:8px;font:600 19px Manrope,sans-serif;color:#2F4652\"><span style=\"background:#F4F6F7;border-radius:6px;padding:6px 10px\">Pricing</span><span style=\"background:#F4F6F7;border-radius:6px;padding:6px 10px\">Course offerings</span><span style=\"background:#F4F6F7;border-radius:6px;padding:6px 10px\">Company description</span><span style=\"background:#F4F6F7;border-radius:6px;padding:6px 10px\">Support information</span><span style=\"background:#F4F6F7;border-radius:6px;padding:6px 10px\">Coupon codes</span><span style=\"background:#F4F6F7;border-radius:6px;padding:6px 10px\">Logos</span><span style=\"background:#F4F6F7;border-radius:6px;padding:6px 10px\">Website links</span><span style=\"background:#F4F6F7;border-radius:6px;padding:6px 10px\">Course features</span><span style=\"background:#F4F6F7;border-radius:6px;padding:6px 10px\">Promotional offers</span></div>\n        <a href=\"/provider-application/\" style=\"margin-top:auto;display:block;text-align:center;background:#95AB3B;color:#fff;font:700 22px Manrope,sans-serif;padding:14px;border-radius:8px\" data-hv=\"4\">Claim Your Provider Profile</a>\n      </div>\n      <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:36px;display:flex;flex-direction:column;gap:14px;box-shadow:0 2px 8px rgba(11,46,64,.06)\">\n        <h3 style=\"margin:0;font:800 26px/1.2 Manrope,sans-serif;letter-spacing:-.01em\">What Providers Cannot Change</h3>\n        <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">Providers generally cannot demand changes to:</p>\n        <div style=\"display:flex;flex-direction:column;gap:10px;font-size:22px;line-height:1.5;color:#2F4652\">\n          <div style=\"display:flex;gap:10px\"><span style=\"color:#C0392B;font-weight:700;flex:none\">–</span>Published comparisons supported by accurate information</div>\n        </div>\n        <p style=\"margin:0;font-size:22px;line-height:1.6;color:#5A6E78;border-top:1px solid #E3E9EB;padding-top:14px\">This does not prevent a provider from notifying us when the underlying information is incorrect.</p>\n      </div>\n    </div>\n  </div>\n\n  \n  <div id=\"correction\" style=\"background:#fff;padding:72px 56px;scroll-margin-top:120px\">\n    <div style=\"max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1.2fr;gap:64px;align-items:start\">\n      <div style=\"display:flex;flex-direction:column;gap:16px\">\n        <div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">How to Request a Correction</div>\n        <h2 style=\"margin:0;font:800 52px/1.1 Manrope,sans-serif;letter-spacing:-.02em\">Something Wrong?</h2>\n        <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">Send us the details below and our team will review them. Everything funnels through one address:</p>\n        <a href=\"mailto:providers@taxcoursefinder.com\" style=\"display:inline-flex;align-self:flex-start;align-items:center;gap:10px;background:#F3F5E6;border:1.5px dashed #95AB3B;color:#7E9330;font:700 22px ui-monospace,Menlo,monospace;padding:12px 16px;border-radius:8px\">providers@taxcoursefinder.com</a>\n        <a href=\"mailto:providers@taxcoursefinder.com\" style=\"display:inline-block;align-self:flex-start;background:#0B2E40;color:#fff;font:700 22px Manrope,sans-serif;padding:14px 24px;border-radius:8px\" data-hv=\"10\">Request a Correction</a>\n      </div>\n      <div style=\"background:#F4F6F7;border-radius:16px;padding:32px 36px\">\n        <div style=\"font:700 22px Manrope,sans-serif;margin-bottom:18px\">Send us:</div>\n        <div style=\"display:flex;flex-direction:column;gap:12px;font-size:22px;color:#2F4652\">\n          <div style=\"display:flex;gap:14px;align-items:center\"><span style=\"width:28px;height:28px;border-radius:8px;background:#0B2E40;color:#fff;display:grid;place-items:center;font:800 19px Manrope,sans-serif;flex:none\">1</span>Company name</div>\n          <div style=\"display:flex;gap:14px;align-items:center\"><span style=\"width:28px;height:28px;border-radius:8px;background:#0B2E40;color:#fff;display:grid;place-items:center;font:800 19px Manrope,sans-serif;flex:none\">2</span>Your name and position</div>\n          <div style=\"display:flex;gap:14px;align-items:center\"><span style=\"width:28px;height:28px;border-radius:8px;background:#0B2E40;color:#fff;display:grid;place-items:center;font:800 19px Manrope,sans-serif;flex:none\">3</span>The page containing the information</div>\n          <div style=\"display:flex;gap:14px;align-items:center\"><span style=\"width:28px;height:28px;border-radius:8px;background:#0B2E40;color:#fff;display:grid;place-items:center;font:800 19px Manrope,sans-serif;flex:none\">4</span>What information you believe is incorrect</div>\n          <div style=\"display:flex;gap:14px;align-items:center\"><span style=\"width:28px;height:28px;border-radius:8px;background:#0B2E40;color:#fff;display:grid;place-items:center;font:800 19px Manrope,sans-serif;flex:none\">5</span>The correct information</div>\n          <div style=\"display:flex;gap:14px;align-items:center\"><span style=\"width:28px;height:28px;border-radius:8px;background:#0B2E40;color:#fff;display:grid;place-items:center;font:800 19px Manrope,sans-serif;flex:none\">6</span>Supporting documentation or URL</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  \n  <div style=\"background:#F4F6F7;padding:80px 56px;color:#0B2E40\">\n    <div style=\"max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:20px\">\n      <div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#2F4652\">Our Accuracy Commitment</div>\n      <h2 style=\"margin:0;font:300 52px/1.1 Manrope,sans-serif;letter-spacing:-.02em;text-wrap:pretty;max-width:900px\">Our goal is simple: <span style=\"font-weight:800\">accurate information and fair comparisons.</span></h2>\n      <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652;max-width:820px\">California Tax Course Finder benefits when students trust the information they find here. Providers benefit when their businesses are represented accurately.</p>\n      <p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652;max-width:820px\">When legitimate factual errors are brought to our attention, we will make reasonable efforts to investigate and correct them promptly.</p>\n      <p style=\"margin:0;font:700 22px/1.5 Manrope,sans-serif;color:#0B2E40;border-left:3px solid #0B2E40;padding-left:20px\">Correcting inaccurate factual information is always free.</p>\n    </div>\n  </div>\n\n  \n</div>\n  \n"
}