 "code": "\nclass Component extends DCLogic {\n  state = {};\n  subTimer = null;\n  subInit() { return;\n    const st = this.state.subState || {};\n    if (localStorage.getItem('tcf_sub_dismissed') || localStorage.getItem('tcf_sub_done')) return;\n    this.subTimer = setTimeout(() => this.setState({ subOpen: true }), 30000);\n  }\n  subVals() {\n    return {\n      subOpen: !!this.state.subOpen, subDone: !!this.state.subDone, subPending: !this.state.subDone, subEmail: this.state.subEmail || '',\n      subChange: ev => this.setState({ subEmail: ev.target.value }),\n      subClose: () => { localStorage.setItem('tcf_sub_dismissed', String(Date.now())); this.setState({ subOpen: false }); },\n      subSubmit: ev => { ev.preventDefault(); localStorage.setItem('tcf_sub_done', '1'); this.setState({ subDone: true }); setTimeout(() => this.setState({ subOpen: false }), 2500); }\n    };\n  }\n  componentDidMount() { this.subInit(); }\n  componentWillUnmount() { clearTimeout(this.subTimer); }\n  renderVals() { return { ...this.subVals() }; }\n}\n",
 "props": {},
 "name": "How to Become a CTEC Tax Preparer",
 "slug": "how-to-become-a-ctec-registered-tax-preparer",
 "url": "/how-to-become-a-ctec-registered-tax-preparer/",
 "title": "How to Become a CTEC Registered Tax Preparer",
 "runtime": false,
 "rid": "tcf-how-to-become-a-ctec-registered-tax-preparer",
 "widget": "<div class=\"tcf-page tcf-scope tcf-p-how-to-become-a-ctec-registered-tax-preparer\"><div id=\"tcf-how-to-become-a-ctec-registered-tax-preparer-root\" class=\"tcf-root\">@@SSR@@</div></div>\n<template id=\"tcf-how-to-become-a-ctec-registered-tax-preparer-tpl\">\n\n\n<div data-screen-label=\"How to Become a CTEC Tax Preparer\" class=\"tcf-screen\">\n  \n  <div style=\"position:relative;overflow:hidden;color:#fff;padding:110px 56px 100px\">\n    <img src=\"@@MEDIA:photos/01-ctec-60-hour-learner.webp@@\" alt=\"\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover\"><div style=\"position:absolute;inset:0;background:linear-gradient(100deg,rgba(11,46,64,.96) 0%,rgba(11,46,64,.88) 55%,rgba(11,46,64,.78) 100%)\"></div>\n      <div style=\"position:absolute;inset:0;background-image:linear-gradient(135deg,rgba(255,255,255,.07) 0%,rgba(255,255,255,0) 55%);\"></div>\n\n    <div style=\"position:relative;max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:20px\">\n      <div style=\"font:700 22px Manrope,sans-serif;letter-spacing:1.6px;text-transform:uppercase;color:#95AB3B\">For new preparers</div>\n      <h1 style=\"margin:0;font:300 52px/1.05 Manrope,sans-serif;letter-spacing:-.03em;max-width:900px\">How to Become a <span style=\"display:block;font-weight:800\">CTEC Registered Tax Preparer in California</span></h1>\n      <p style=\"margin:0;font-size:22px;line-height:1.6;color:rgba(255,255,255,.88);max-width:660px;text-wrap:pretty\">Anyone who prepares California tax returns for a fee must register with CTEC, unless they are a CPA, enrolled agent, attorney or certain bank employees. Here is the whole path, in order.</p>\n      <div style=\"display:flex;gap:12px;flex-wrap:wrap;margin-top:6px\"><a href=\"/ctec-60-hour-course/#find-schools\" style=\"background:#95AB3B;color:#fff;font:700 22px Manrope,sans-serif;padding:15px 28px;border-radius:8px\" data-hv=\"4\">Compare 60-hour courses</a><a href=\"#steps\" style=\"border:1.5px solid rgba(255,255,255,.45);color:#fff;font:700 22px Manrope,sans-serif;padding:13.5px 26px;border-radius:8px\" data-hv=\"14\">See the five steps</a></div>\n    </div>\n  </div>\n  <div style=\"height:6px;background:linear-gradient(90deg,#95AB3B,#7E9330)\"></div>\n  <div id=\"steps\" style=\"scroll-margin-top:110px\"></div>\n  <div style=\"padding:80px 56px;background:#fff\">\n    <div style=\"max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:30px\">\n      <div style=\"max-width:760px;display:flex;flex-direction:column;gap:12px\">\n        <div style=\"font:700 19px Manrope,sans-serif;letter-spacing:1.6px;text-transform:uppercase;color:#7E9330\">The process</div>\n        <h2 style=\"margin:0;font:300 52px/1.12 Manrope,sans-serif;letter-spacing:-.02em\">Five steps to your <span style=\"font-weight:800\">CRTP registration</span></h2>\n        <p style=\"margin:0;font-size:22px;line-height:1.65;color:#2F4652;text-wrap:pretty\">Most people complete the course first, because the certificate of completion is what CTEC needs before it will accept your registration. The other items can be arranged while you study.</p>\n      </div>\n      <div style=\"display:flex;flex-direction:column\">\n        <div style=\"display:grid;grid-template-columns:64px 1fr;gap:22px;padding:24px 0;border-top:1px solid #E3E9EB;align-items:start\">\n          <div style=\"font:300 52px/1 Manrope,sans-serif;letter-spacing:-.03em;color:#7E9330\">01</div>\n          <div><div style=\"font:800 26px Manrope,sans-serif;letter-spacing:-.01em\">Complete a 60-hour qualifying education course</div><p style=\"margin:6px 0 0;font-size:22px;line-height:1.6;color:#2F4652;max-width:760px;text-wrap:pretty\">The course must come from a CTEC-approved education provider. It covers federal tax law, ethics and California tax law, and ends with a final exam. Providers report your completion to CTEC directly, so keep your name and details consistent with your other paperwork.</p></div>\n        </div>\n        <div style=\"display:grid;grid-template-columns:64px 1fr;gap:22px;padding:24px 0;border-top:1px solid #E3E9EB;align-items:start\">\n          <div style=\"font:300 52px/1 Manrope,sans-serif;letter-spacing:-.03em;color:#7E9330\">02</div>\n          <div><div style=\"font:800 26px Manrope,sans-serif;letter-spacing:-.01em\">Get a PTIN from the IRS</div><p style=\"margin:6px 0 0;font-size:22px;line-height:1.6;color:#2F4652;max-width:760px;text-wrap:pretty\">A Preparer Tax Identification Number is required by the IRS for anyone who prepares federal returns for compensation. Apply through the IRS website; you renew it each year.</p></div>\n        </div>\n        <div style=\"display:grid;grid-template-columns:64px 1fr;gap:22px;padding:24px 0;border-top:1px solid #E3E9EB;align-items:start\">\n          <div style=\"font:300 52px/1 Manrope,sans-serif;letter-spacing:-.03em;color:#7E9330\">03</div>\n          <div><div style=\"font:800 26px Manrope,sans-serif;letter-spacing:-.01em\">Buy a $5,000 tax preparer surety bond</div><p style=\"margin:6px 0 0;font-size:22px;line-height:1.6;color:#2F4652;max-width:760px;text-wrap:pretty\">California requires a $5,000 surety bond that protects your clients. Bonds are sold by insurance agencies and are inexpensive. Keep the bond current for as long as you are registered.</p></div>\n        </div>\n        <div style=\"display:grid;grid-template-columns:64px 1fr;gap:22px;padding:24px 0;border-top:1px solid #E3E9EB;align-items:start\">\n          <div style=\"font:300 52px/1 Manrope,sans-serif;letter-spacing:-.03em;color:#7E9330\">04</div>\n          <div><div style=\"font:800 26px Manrope,sans-serif;letter-spacing:-.01em\">Pass a background check and Live Scan</div><p style=\"margin:6px 0 0;font-size:22px;line-height:1.6;color:#2F4652;max-width:760px;text-wrap:pretty\">CTEC requires fingerprinting and a background check for new applicants. Use an approved Live Scan location and follow CTEC’s current instructions for submitting your results.</p></div>\n        </div>\n        <div style=\"display:grid;grid-template-columns:64px 1fr;gap:22px;padding:24px 0;border-top:1px solid #E3E9EB;align-items:start\">\n          <div style=\"font:300 52px/1 Manrope,sans-serif;letter-spacing:-.03em;color:#7E9330\">05</div>\n          <div><div style=\"font:800 26px Manrope,sans-serif;letter-spacing:-.01em\">Register with CTEC and pay the fee</div><p style=\"margin:6px 0 0;font-size:22px;line-height:1.6;color:#2F4652;max-width:760px;text-wrap:pretty\">Apply on CTEC’s website within 18 months of completing your course, upload your documents, and pay the registration fee. Once approved you are a CRTP and may prepare California returns for a fee.</p></div>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div style=\"padding:80px 56px;background:#0B2E40;color:#fff\">\n    <div style=\"max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1.1fr;gap:56px;align-items:center\">\n      <div style=\"display:flex;flex-direction:column;gap:14px\">\n        <div style=\"font:700 19px Manrope,sans-serif;letter-spacing:1.6px;text-transform:uppercase;color:#95AB3B\">Required hours</div>\n        <h2 style=\"margin:0;font:300 52px/1.12 Manrope,sans-serif;letter-spacing:-.02em;color:#fff\">What the 60-hour qualifying course covers</h2>\n        <p style=\"margin:0;font-size:22px;line-height:1.65;color:rgba(255,255,255,.88);text-wrap:pretty\">Hour categories are set by CTEC; providers arrange the syllabus inside them. Course lengths, formats and prices vary widely, which is what the directory is for.</p>\n        <a href=\"/ctec-requirements/\" style=\"align-self:flex-start;font:700 22px Manrope,sans-serif;color:#95AB3B;margin-top:2px\">Full CTEC requirements →</a>\n      </div>\n      <div style=\"background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:16px;overflow:hidden\">\n        <div style=\"display:flex;justify-content:space-between;align-items:baseline;padding:18px 24px;background:rgba(108,190,69,.18);border-bottom:1px solid rgba(255,255,255,.14)\"><span style=\"font:700 19px Manrope,sans-serif;letter-spacing:1.4px;text-transform:uppercase;color:#fff\">Total</span><span style=\"font:800 26px Manrope,sans-serif\">60 hours</span></div>\n        <div style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 24px;\"><span style=\"font-size:22px;color:rgba(255,255,255,.9)\">Federal tax law</span><span style=\"font:800 22px Manrope,sans-serif;color:#fff;white-space:nowrap\">43 hrs</span></div>\n        <div style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 24px;border-top:1px solid rgba(255,255,255,.1)\"><span style=\"font-size:22px;color:rgba(255,255,255,.9)\">Ethics</span><span style=\"font:800 22px Manrope,sans-serif;color:#fff;white-space:nowrap\">2 hrs</span></div>\n        <div style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 24px;border-top:1px solid rgba(255,255,255,.1)\"><span style=\"font-size:22px;color:rgba(255,255,255,.9)\">California tax law</span><span style=\"font:800 22px Manrope,sans-serif;color:#fff;white-space:nowrap\">15 hrs</span></div>\n      </div>\n    </div>\n  </div>\n  <div style=\"padding:80px 56px;background:#F4F6F7\">\n    <div style=\"max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:28px\">\n      <h2 style=\"margin:0;font:300 52px/1.12 Manrope,sans-serif;letter-spacing:-.02em;text-align:center\">After you register</h2>\n      <div style=\"display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px\">\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:28px;display:flex;flex-direction:column;gap:10px\"><div style=\"font:800 19px Manrope,sans-serif;letter-spacing:.06em;color:#7E9330\">EVERY YEAR</div><div style=\"font:800 26px Manrope,sans-serif;letter-spacing:-.01em\">Renew by October 31</div><p style=\"margin:0;font-size:22px;line-height:1.58;color:#2F4652\">Complete 20 hours of continuing education, renew your PTIN and bond, and renew with CTEC.</p></div>\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:28px;display:flex;flex-direction:column;gap:10px\"><div style=\"font:800 19px Manrope,sans-serif;letter-spacing:.06em;color:#C48A00\">NOV 1 – JAN 15</div><div style=\"font:800 26px Manrope,sans-serif;letter-spacing:-.01em\">Late renewal window</div><p style=\"margin:0;font-size:22px;line-height:1.58;color:#2F4652\">Renewal is still possible with a late fee in addition to the standard renewal fee.</p></div>\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:28px;display:flex;flex-direction:column;gap:10px\"><div style=\"font:800 19px Manrope,sans-serif;letter-spacing:.06em;color:#C0392B\">AFTER JAN 15</div><div style=\"font:800 26px Manrope,sans-serif;letter-spacing:-.01em\">Registration lapses</div><p style=\"margin:0;font-size:22px;line-height:1.58;color:#2F4652\">You must retake the 60-hour qualifying course and register again as a new preparer.</p></div>\n      </div>\n    </div>\n  </div>\n  <div style=\"padding:80px 56px;background:#fff\">\n    <div style=\"max-width:1200px;margin:0 auto;display:grid;grid-template-columns:300px 1fr;gap:56px;align-items:start\">\n      <div><div style=\"font:700 19px Manrope,sans-serif;letter-spacing:1.6px;text-transform:uppercase;color:#7E9330;margin-bottom:10px\">Questions</div><h2 style=\"margin:0;font:300 34px/1.12 Manrope,sans-serif;letter-spacing:-.02em\">Common questions</h2></div>\n      <div style=\"display:flex;flex-direction:column;gap:12px\">\n        <div style=\"border:1px solid #E3E9EB;border-radius:14px;padding:22px 26px\"><div style=\"font:800 22px Manrope,sans-serif;margin-bottom:7px\">Do I need a college degree?</div><p style=\"margin:0;font-size:22px;line-height:1.62;color:#2F4652\">No. Qualifying education plus the PTIN, bond, background check and CTEC registration are the requirements.</p></div>\n        <div style=\"border:1px solid #E3E9EB;border-radius:14px;padding:22px 26px\"><div style=\"font:800 22px Manrope,sans-serif;margin-bottom:7px\">How long does the 60-hour course take?</div><p style=\"margin:0;font-size:22px;line-height:1.62;color:#2F4652\">Self-paced courses are commonly finished in a few weeks of part-time study. There is no minimum number of days, but providers set an access period.</p></div>\n        <div style=\"border:1px solid #E3E9EB;border-radius:14px;padding:22px 26px\"><div style=\"font:800 22px Manrope,sans-serif;margin-bottom:7px\">Can I prepare returns while I wait for approval?</div><p style=\"margin:0;font-size:22px;line-height:1.62;color:#2F4652\">No. You may not prepare California returns for a fee until your CTEC registration is active.</p></div>\n        <div style=\"border:1px solid #E3E9EB;border-radius:14px;padding:22px 26px\"><div style=\"font:800 22px Manrope,sans-serif;margin-bottom:7px\">Is the course available in Spanish?</div><p style=\"margin:0;font-size:22px;line-height:1.62;color:#2F4652\">Some providers offer Spanish-language courses. Filter for it in the provider directory.</p></div>\n        <div style=\"border:1px solid #E3E9EB;border-radius:14px;padding:22px 26px\"><div style=\"font:800 22px Manrope,sans-serif;margin-bottom:7px\">How long is my course completion valid?</div><p style=\"margin:0;font-size:22px;line-height:1.62;color:#2F4652\">You must register with CTEC within 18 months of completing your qualifying education.</p></div>\n      </div>\n    </div>\n  </div>\n  <div style=\"position:relative;overflow:hidden;padding:56px 56px;background:#F4F6F7\">\n      <div style=\"position:absolute;right:-120px;top:-160px;width:520px;height:520px;border-radius:50%;background:rgba(11,46,64,.14)\"></div>\n      <div style=\"position:absolute;right:180px;bottom:-220px;width:380px;height:380px;border-radius:50%;background:#fff\"></div>\n      <div style=\"position:absolute;inset:0;background-image:linear-gradient(135deg,rgba(255,255,255,.14) 0%,rgba(255,255,255,0) 60%);\"></div>\n\n    <div style=\"position:relative;max-width:1200px;margin:0 auto;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:18px;color:#0B2E40\">\n      <div><h2 style=\"margin:0;font:800 34px/1.15 Manrope,sans-serif;letter-spacing:-.02em;color:#0B2E40\">Ready to start?</h2><p style=\"margin:8px 0 0;font-size:22px;color:#0B2E40\">Compare every CTEC-approved 60-hour course in one place.</p></div>\n      <a href=\"/ctec-60-hour-course/#find-schools\" style=\"flex:none;background:#95AB3B;color:#fff;font:700 22px Manrope,sans-serif;padding:16px 30px;border-radius:8px\" data-hv=\"4\">Compare 60-hour courses</a>\n    </div>\n  </div>\n  \n</div>\n  <sc-if value=\"{{ subOpen }}\" hint-placeholder-val=\"{{ false }}\">\n  <div style=\"position:fixed;right:24px;bottom:24px;z-index:80;width:380px;max-width:calc(100vw - 32px);background:#fff;border:1px solid #D7DFE2;border-radius:18px;box-shadow:0 30px 70px rgba(11,46,64,.28);overflow:hidden;font-family:'Source Sans 3',sans-serif;color:#0B2E40\">\n    <div style=\"height:5px;background:#95AB3B\"></div>\n    <div onclick=\"{{ subClose }}\" title=\"Close\" style=\"position:absolute;top:14px;right:12px;width:36px;height:36px;display:grid;place-items:center;border-radius:8px;cursor:pointer;color:#5A6E78\" data-hv=\"7\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M6 6l12 12M18 6L6 18\"></path></svg></div>\n    <div style=\"padding:26px 26px 24px;display:flex;flex-direction:column;gap:14px\">\n      <div style=\"font:700 15px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">Monthly coupon codes</div>\n      <div style=\"font:800 26px/1.15 Manrope,sans-serif;letter-spacing:-.01em;padding-right:24px\">Get CTEC course coupon codes every month</div>\n      <p style=\"margin:0;font-size:17px;line-height:1.5;color:#5A6E78\">New codes from different course providers each month, plus an alert when a sale starts. No spam, unsubscribe anytime.</p>\n      <sc-if value=\"{{ subDone }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"background:#F3F5E6;border:1px solid #D7EDC8;border-radius:10px;padding:14px 16px;font:700 17px Manrope,sans-serif;color:#7E9330\">You're in. Watch for this month's codes.</div></sc-if>\n      <sc-if value=\"{{ subPending }}\" hint-placeholder-val=\"{{ true }}\">\n      <form onsubmit=\"{{ subSubmit }}\" style=\"display:flex;flex-direction:column;gap:10px\">\n        <input type=\"email\" required=\"\" value=\"{{ subEmail }}\" onchange=\"{{ subChange }}\" placeholder=\"you@example.com\" style=\"height:50px;border:1px solid #D7DFE2;border-radius:10px;padding:0 16px;font:400 17px 'Source Sans 3',sans-serif;color:#0B2E40;outline:none;width:100%;box-sizing:border-box\">\n        <button type=\"submit\" style=\"height:50px;border:0;border-radius:10px;background:#95AB3B;color:#fff;font:700 17px Manrope,sans-serif;cursor:pointer\" data-hv=\"6\">Send me the codes</button>\n      </form>\n      </sc-if>\n      <div style=\"font-size:15px;color:#8A9AA3\">By subscribing you agree to our <a href=\"/privacy-policy/\" style=\"color:#7E9330;font-weight:700\">Privacy Policy</a>.</div>\n    </div>\n  </div>\n  </sc-if>\n</template>",
 "css": "body{margin:0;background:#fff;font-family:\"Source Sans 3\",system-ui,sans-serif;color:#0B2E40}a{color:#7E9330;text-decoration:none}a:hover{color:#7E9330}a:visited{color:#7E9330}a:active{color:#7E9330}a:focus{outline:none}html{scrollbar-gutter:stable}button,select{font:inherit}button:focus,select:focus,input:focus{outline:none}.dd-menu a{display:flex!important;align-items:center;justify-content:space-between;gap:18px}.dd .dd-menu{display:none}.dd:hover .dd-menu,.dd:focus-within .dd-menu{display:block}",
 "ssr": "\n\n\n<div data-screen-label=\"How to Become a CTEC Tax Preparer\" class=\"tcf-screen\">\n  \n  <div style=\"position:relative;overflow:hidden;color:#fff;padding:110px 56px 100px\">\n    <img src=\"/assets/photos/01-ctec-60-hour-learner.webp\" alt=\"\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover\"><div style=\"position:absolute;inset:0;background:linear-gradient(100deg,rgba(11,46,64,.96) 0%,rgba(11,46,64,.88) 55%,rgba(11,46,64,.78) 100%)\"></div>\n      <div style=\"position:absolute;inset:0;background-image:linear-gradient(135deg,rgba(255,255,255,.07) 0%,rgba(255,255,255,0) 55%);\"></div>\n\n    <div style=\"position:relative;max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:20px\">\n      <div style=\"font:700 22px Manrope,sans-serif;letter-spacing:1.6px;text-transform:uppercase;color:#95AB3B\">For new preparers</div>\n      <h1 style=\"margin:0;font:300 52px/1.05 Manrope,sans-serif;letter-spacing:-.03em;max-width:900px\">How to Become a <span style=\"display:block;font-weight:800\">CTEC Registered Tax Preparer in California</span></h1>\n      <p style=\"margin:0;font-size:22px;line-height:1.6;color:rgba(255,255,255,.88);max-width:660px;text-wrap:pretty\">Anyone who prepares California tax returns for a fee must register with CTEC, unless they are a CPA, enrolled agent, attorney or certain bank employees. Here is the whole path, in order.</p>\n      <div style=\"display:flex;gap:12px;flex-wrap:wrap;margin-top:6px\"><a href=\"/ctec-60-hour-course/#find-schools\" style=\"background:#95AB3B;color:#fff;font:700 22px Manrope,sans-serif;padding:15px 28px;border-radius:8px\" data-hv=\"4\">Compare 60-hour courses</a><a href=\"#steps\" style=\"border:1.5px solid rgba(255,255,255,.45);color:#fff;font:700 22px Manrope,sans-serif;padding:13.5px 26px;border-radius:8px\" data-hv=\"14\">See the five steps</a></div>\n    </div>\n  </div>\n  <div style=\"height:6px;background:linear-gradient(90deg,#95AB3B,#7E9330)\"></div>\n  <div id=\"steps\" style=\"scroll-margin-top:110px\"></div>\n  <div style=\"padding:80px 56px;background:#fff\">\n    <div style=\"max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:30px\">\n      <div style=\"max-width:760px;display:flex;flex-direction:column;gap:12px\">\n        <div style=\"font:700 19px Manrope,sans-serif;letter-spacing:1.6px;text-transform:uppercase;color:#7E9330\">The process</div>\n        <h2 style=\"margin:0;font:300 52px/1.12 Manrope,sans-serif;letter-spacing:-.02em\">Five steps to your <span style=\"font-weight:800\">CRTP registration</span></h2>\n        <p style=\"margin:0;font-size:22px;line-height:1.65;color:#2F4652;text-wrap:pretty\">Most people complete the course first, because the certificate of completion is what CTEC needs before it will accept your registration. The other items can be arranged while you study.</p>\n      </div>\n      <div style=\"display:flex;flex-direction:column\">\n        <div style=\"display:grid;grid-template-columns:64px 1fr;gap:22px;padding:24px 0;border-top:1px solid #E3E9EB;align-items:start\">\n          <div style=\"font:300 52px/1 Manrope,sans-serif;letter-spacing:-.03em;color:#7E9330\">01</div>\n          <div><div style=\"font:800 26px Manrope,sans-serif;letter-spacing:-.01em\">Complete a 60-hour qualifying education course</div><p style=\"margin:6px 0 0;font-size:22px;line-height:1.6;color:#2F4652;max-width:760px;text-wrap:pretty\">The course must come from a CTEC-approved education provider. It covers federal tax law, ethics and California tax law, and ends with a final exam. Providers report your completion to CTEC directly, so keep your name and details consistent with your other paperwork.</p></div>\n        </div>\n        <div style=\"display:grid;grid-template-columns:64px 1fr;gap:22px;padding:24px 0;border-top:1px solid #E3E9EB;align-items:start\">\n          <div style=\"font:300 52px/1 Manrope,sans-serif;letter-spacing:-.03em;color:#7E9330\">02</div>\n          <div><div style=\"font:800 26px Manrope,sans-serif;letter-spacing:-.01em\">Get a PTIN from the IRS</div><p style=\"margin:6px 0 0;font-size:22px;line-height:1.6;color:#2F4652;max-width:760px;text-wrap:pretty\">A Preparer Tax Identification Number is required by the IRS for anyone who prepares federal returns for compensation. Apply through the IRS website; you renew it each year.</p></div>\n        </div>\n        <div style=\"display:grid;grid-template-columns:64px 1fr;gap:22px;padding:24px 0;border-top:1px solid #E3E9EB;align-items:start\">\n          <div style=\"font:300 52px/1 Manrope,sans-serif;letter-spacing:-.03em;color:#7E9330\">03</div>\n          <div><div style=\"font:800 26px Manrope,sans-serif;letter-spacing:-.01em\">Buy a $5,000 tax preparer surety bond</div><p style=\"margin:6px 0 0;font-size:22px;line-height:1.6;color:#2F4652;max-width:760px;text-wrap:pretty\">California requires a $5,000 surety bond that protects your clients. Bonds are sold by insurance agencies and are inexpensive. Keep the bond current for as long as you are registered.</p></div>\n        </div>\n        <div style=\"display:grid;grid-template-columns:64px 1fr;gap:22px;padding:24px 0;border-top:1px solid #E3E9EB;align-items:start\">\n          <div style=\"font:300 52px/1 Manrope,sans-serif;letter-spacing:-.03em;color:#7E9330\">04</div>\n          <div><div style=\"font:800 26px Manrope,sans-serif;letter-spacing:-.01em\">Pass a background check and Live Scan</div><p style=\"margin:6px 0 0;font-size:22px;line-height:1.6;color:#2F4652;max-width:760px;text-wrap:pretty\">CTEC requires fingerprinting and a background check for new applicants. Use an approved Live Scan location and follow CTEC’s current instructions for submitting your results.</p></div>\n        </div>\n        <div style=\"display:grid;grid-template-columns:64px 1fr;gap:22px;padding:24px 0;border-top:1px solid #E3E9EB;align-items:start\">\n          <div style=\"font:300 52px/1 Manrope,sans-serif;letter-spacing:-.03em;color:#7E9330\">05</div>\n          <div><div style=\"font:800 26px Manrope,sans-serif;letter-spacing:-.01em\">Register with CTEC and pay the fee</div><p style=\"margin:6px 0 0;font-size:22px;line-height:1.6;color:#2F4652;max-width:760px;text-wrap:pretty\">Apply on CTEC’s website within 18 months of completing your course, upload your documents, and pay the registration fee. Once approved you are a CRTP and may prepare California returns for a fee.</p></div>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div style=\"padding:80px 56px;background:#0B2E40;color:#fff\">\n    <div style=\"max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1.1fr;gap:56px;align-items:center\">\n      <div style=\"display:flex;flex-direction:column;gap:14px\">\n        <div style=\"font:700 19px Manrope,sans-serif;letter-spacing:1.6px;text-transform:uppercase;color:#95AB3B\">Required hours</div>\n        <h2 style=\"margin:0;font:300 52px/1.12 Manrope,sans-serif;letter-spacing:-.02em;color:#fff\">What the 60-hour qualifying course covers</h2>\n        <p style=\"margin:0;font-size:22px;line-height:1.65;color:rgba(255,255,255,.88);text-wrap:pretty\">Hour categories are set by CTEC; providers arrange the syllabus inside them. Course lengths, formats and prices vary widely, which is what the directory is for.</p>\n        <a href=\"/ctec-requirements/\" style=\"align-self:flex-start;font:700 22px Manrope,sans-serif;color:#95AB3B;margin-top:2px\">Full CTEC requirements →</a>\n      </div>\n      <div style=\"background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:16px;overflow:hidden\">\n        <div style=\"display:flex;justify-content:space-between;align-items:baseline;padding:18px 24px;background:rgba(108,190,69,.18);border-bottom:1px solid rgba(255,255,255,.14)\"><span style=\"font:700 19px Manrope,sans-serif;letter-spacing:1.4px;text-transform:uppercase;color:#fff\">Total</span><span style=\"font:800 26px Manrope,sans-serif\">60 hours</span></div>\n        <div style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 24px;\"><span style=\"font-size:22px;color:rgba(255,255,255,.9)\">Federal tax law</span><span style=\"font:800 22px Manrope,sans-serif;color:#fff;white-space:nowrap\">43 hrs</span></div>\n        <div style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 24px;border-top:1px solid rgba(255,255,255,.1)\"><span style=\"font-size:22px;color:rgba(255,255,255,.9)\">Ethics</span><span style=\"font:800 22px Manrope,sans-serif;color:#fff;white-space:nowrap\">2 hrs</span></div>\n        <div style=\"display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 24px;border-top:1px solid rgba(255,255,255,.1)\"><span style=\"font-size:22px;color:rgba(255,255,255,.9)\">California tax law</span><span style=\"font:800 22px Manrope,sans-serif;color:#fff;white-space:nowrap\">15 hrs</span></div>\n      </div>\n    </div>\n  </div>\n  <div style=\"padding:80px 56px;background:#F4F6F7\">\n    <div style=\"max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:28px\">\n      <h2 style=\"margin:0;font:300 52px/1.12 Manrope,sans-serif;letter-spacing:-.02em;text-align:center\">After you register</h2>\n      <div style=\"display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px\">\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:28px;display:flex;flex-direction:column;gap:10px\"><div style=\"font:800 19px Manrope,sans-serif;letter-spacing:.06em;color:#7E9330\">EVERY YEAR</div><div style=\"font:800 26px Manrope,sans-serif;letter-spacing:-.01em\">Renew by October 31</div><p style=\"margin:0;font-size:22px;line-height:1.58;color:#2F4652\">Complete 20 hours of continuing education, renew your PTIN and bond, and renew with CTEC.</p></div>\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:28px;display:flex;flex-direction:column;gap:10px\"><div style=\"font:800 19px Manrope,sans-serif;letter-spacing:.06em;color:#C48A00\">NOV 1 – JAN 15</div><div style=\"font:800 26px Manrope,sans-serif;letter-spacing:-.01em\">Late renewal window</div><p style=\"margin:0;font-size:22px;line-height:1.58;color:#2F4652\">Renewal is still possible with a late fee in addition to the standard renewal fee.</p></div>\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:28px;display:flex;flex-direction:column;gap:10px\"><div style=\"font:800 19px Manrope,sans-serif;letter-spacing:.06em;color:#C0392B\">AFTER JAN 15</div><div style=\"font:800 26px Manrope,sans-serif;letter-spacing:-.01em\">Registration lapses</div><p style=\"margin:0;font-size:22px;line-height:1.58;color:#2F4652\">You must retake the 60-hour qualifying course and register again as a new preparer.</p></div>\n      </div>\n    </div>\n  </div>\n  <div style=\"padding:80px 56px;background:#fff\">\n    <div style=\"max-width:1200px;margin:0 auto;display:grid;grid-template-columns:300px 1fr;gap:56px;align-items:start\">\n      <div><div style=\"font:700 19px Manrope,sans-serif;letter-spacing:1.6px;text-transform:uppercase;color:#7E9330;margin-bottom:10px\">Questions</div><h2 style=\"margin:0;font:300 34px/1.12 Manrope,sans-serif;letter-spacing:-.02em\">Common questions</h2></div>\n      <div style=\"display:flex;flex-direction:column;gap:12px\">\n        <div style=\"border:1px solid #E3E9EB;border-radius:14px;padding:22px 26px\"><div style=\"font:800 22px Manrope,sans-serif;margin-bottom:7px\">Do I need a college degree?</div><p style=\"margin:0;font-size:22px;line-height:1.62;color:#2F4652\">No. Qualifying education plus the PTIN, bond, background check and CTEC registration are the requirements.</p></div>\n        <div style=\"border:1px solid #E3E9EB;border-radius:14px;padding:22px 26px\"><div style=\"font:800 22px Manrope,sans-serif;margin-bottom:7px\">How long does the 60-hour course take?</div><p style=\"margin:0;font-size:22px;line-height:1.62;color:#2F4652\">Self-paced courses are commonly finished in a few weeks of part-time study. There is no minimum number of days, but providers set an access period.</p></div>\n        <div style=\"border:1px solid #E3E9EB;border-radius:14px;padding:22px 26px\"><div style=\"font:800 22px Manrope,sans-serif;margin-bottom:7px\">Can I prepare returns while I wait for approval?</div><p style=\"margin:0;font-size:22px;line-height:1.62;color:#2F4652\">No. You may not prepare California returns for a fee until your CTEC registration is active.</p></div>\n        <div style=\"border:1px solid #E3E9EB;border-radius:14px;padding:22px 26px\"><div style=\"font:800 22px Manrope,sans-serif;margin-bottom:7px\">Is the course available in Spanish?</div><p style=\"margin:0;font-size:22px;line-height:1.62;color:#2F4652\">Some providers offer Spanish-language courses. Filter for it in the provider directory.</p></div>\n        <div style=\"border:1px solid #E3E9EB;border-radius:14px;padding:22px 26px\"><div style=\"font:800 22px Manrope,sans-serif;margin-bottom:7px\">How long is my course completion valid?</div><p style=\"margin:0;font-size:22px;line-height:1.62;color:#2F4652\">You must register with CTEC within 18 months of completing your qualifying education.</p></div>\n      </div>\n    </div>\n  </div>\n  <div style=\"position:relative;overflow:hidden;padding:56px 56px;background:#F4F6F7\">\n      <div style=\"position:absolute;right:-120px;top:-160px;width:520px;height:520px;border-radius:50%;background:rgba(11,46,64,.14)\"></div>\n      <div style=\"position:absolute;right:180px;bottom:-220px;width:380px;height:380px;border-radius:50%;background:#fff\"></div>\n      <div style=\"position:absolute;inset:0;background-image:linear-gradient(135deg,rgba(255,255,255,.14) 0%,rgba(255,255,255,0) 60%);\"></div>\n\n    <div style=\"position:relative;max-width:1200px;margin:0 auto;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:18px;color:#0B2E40\">\n      <div><h2 style=\"margin:0;font:800 34px/1.15 Manrope,sans-serif;letter-spacing:-.02em;color:#0B2E40\">Ready to start?</h2><p style=\"margin:8px 0 0;font-size:22px;color:#0B2E40\">Compare every CTEC-approved 60-hour course in one place.</p></div>\n      <a href=\"/ctec-60-hour-course/#find-schools\" style=\"flex:none;background:#95AB3B;color:#fff;font:700 22px Manrope,sans-serif;padding:16px 30px;border-radius:8px\" data-hv=\"4\">Compare 60-hour courses</a>\n    </div>\n  </div>\n  \n</div>\n  \n"
}