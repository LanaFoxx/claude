 "code": "\nclass Component extends DCLogic {\n  componentDidMount() { this.subInit(); }\n\n  subTimer = null;\n  subInit() { return;\n    const st = this.state.subState || {};\n    if (localStorage.getItem('tcf_sub_dismissed') || localStorage.getItem('tcf_sub_done')) return;\n    this.subTimer = setTimeout(() => this.setState({ subOpen: true }), 30000);\n  }\n  subVals() {\n    return {\n      subOpen: !!this.state.subOpen, subDone: !!this.state.subDone, subPending: !this.state.subDone, subEmail: this.state.subEmail || '',\n      subChange: ev => this.setState({ subEmail: ev.target.value }),\n      subClose: () => { localStorage.setItem('tcf_sub_dismissed', String(Date.now())); this.setState({ subOpen: false }); },\n      subSubmit: ev => { ev.preventDefault(); localStorage.setItem('tcf_sub_done', '1'); this.setState({ subDone: true }); setTimeout(() => this.setState({ subOpen: false }), 2500); }\n    };\n  }\n  renderVals() {\n    return { ...this.subVals(), groups: [\n      { eyebrow: 'Requirements', title: 'CTEC courses', items: [\n        { q: 'Do I need the 60-hour or the 20-hour course?', a: 'New preparers registering with CTEC for the first time take the 60-hour qualifying course. Registered preparers take 20 hours of continuing education every year to renew.' },\n        { q: 'When is the renewal deadline?', a: 'October 31 each year. Late renewal runs through January 15 with a late fee. After that your registration lapses and you must retake the 60-hour course.' },\n        { q: 'Do I report my own hours to CTEC?', a: 'No. Your provider reports completions to CTEC. Timing varies by provider, so ask the school how soon it reports before you enroll.' },\n        { q: 'Are IRS AFSP hours the same as CTEC hours?', a: 'No, though many providers bundle them. CTEC requires California-specific hours the IRS program does not.' }\n      ]},\n      { eyebrow: 'Using this site', title: 'Comparing providers', items: [\n        { q: 'Where do prices come from?', a: 'Provider websites and provider-submitted pricing, checked weekly. Coupon prices are calculated from the listed code and verified before publication.' },\n        { q: 'What does the Verified badge mean?', a: 'An authorized representative has claimed the profile and confirmed its pricing, courses and policies. It is about accuracy, not endorsement.' }\n      ]},\n      { eyebrow: 'For providers', title: 'Schools listed here', items: [\n        { q: 'We never signed up. Why are we listed?', a: 'Every CTEC-approved provider is included so students see the whole market. Basic listings are free, and correcting factual errors is always free.' },\n        { q: 'How do we fix incorrect information?', a: 'Use Request a Correction, or email providers@taxcoursefinder.com with the page, what is wrong, the correct information, and a source.' }\n      ]}\n    ] };\n  }\n}\n",
 "props": {},
 "name": "FAQs",
 "slug": "faqs",
 "url": "/faqs/",
 "title": "CTEC Course FAQs",
 "runtime": false,
 "rid": "tcf-faqs",
 "widget": "<div class=\"tcf-page tcf-scope tcf-p-faqs\"><div id=\"tcf-faqs-root\" class=\"tcf-root\">@@SSR@@</div></div>\n<template id=\"tcf-faqs-tpl\">\n\n\n<div data-screen-label=\"FAQs\" class=\"tcf-screen\">\n  \n  <div style=\"position:relative;overflow:hidden;color:#fff;padding:110px 56px 100px\">\n    <img src=\"@@MEDIA:photos/comparing-ctec-courses.webp@@\" alt=\"\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover\"><div style=\"position:absolute;inset:0;background:linear-gradient(100deg,rgba(11,46,64,.96) 0%,rgba(11,46,64,.88) 55%,rgba(11,46,64,.78) 100%)\"></div>\n      <div style=\"position:absolute;inset:0;background-image:linear-gradient(135deg,rgba(255,255,255,.07) 0%,rgba(255,255,255,0) 55%);\"></div>\n    <div style=\"position:relative;max-width:1200px;margin:0 auto\"><div style=\"display:flex;flex-direction:column;gap:22px;max-width:820px\">\n      <span style=\"align-self:flex-start;border:1px solid rgba(108,190,69,.5);color:#95AB3B;border-radius:999px;padding:7px 14px;font:700 17px Manrope,sans-serif;letter-spacing:.1em;text-transform:uppercase\">Resources</span>\n      <h1 style=\"margin:0;font:300 64px/1.05 Manrope,sans-serif;letter-spacing:-.03em\"><span style=\"display:block\">CTEC Courses</span><span style=\"display:block;font-weight:800\">Frequently Asked <span style=\"color:#95AB3B\">Questions</span></span></h1>\n      <p style=\"margin:0;font-size:22px;line-height:1.55;color:rgba(255,255,255,.82);max-width:640px;text-wrap:pretty\">About CTEC courses, about this site, and about how providers appear here.</p>\n    </div></div>\n  </div>\n  <div style=\"height:6px;background:linear-gradient(90deg,#95AB3B,#7E9330)\"></div>\n  <div style=\"background:#F4F6F7;padding:88px 56px\">\n    <div style=\"max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:48px\">\n      <sc-for list=\"{{ groups }}\" as=\"g\" hint-placeholder-count=\"3\">\n        <div style=\"display:grid;grid-template-columns:280px 1fr;gap:48px;align-items:start\">\n          <div style=\"position:sticky;top:134px\"><div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330;margin-bottom:10px\">{{ g.eyebrow }}</div><h2 style=\"margin:0;font:800 26px/1.15 Manrope,sans-serif;letter-spacing:-.02em\">{{ g.title }}</h2></div>\n          <div style=\"display:flex;flex-direction:column;gap:12px\"><sc-for list=\"{{ g.items }}\" as=\"q\" hint-placeholder-count=\"4\"><div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:12px;padding:22px 26px;box-shadow:0 2px 8px rgba(11,46,64,.06)\"><div style=\"font:700 22px Manrope,sans-serif;margin-bottom:8px\">{{ q.q }}</div><div style=\"font-size:22px;line-height:1.6;color:#2F4652\">{{ q.a }}</div></div></sc-for></div>\n        </div>\n      </sc-for>\n      <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:32px 36px;display:flex;align-items:center;justify-content:space-between;gap:32px\"><div><div style=\"font:800 26px/1.2 Manrope,sans-serif\">Still have a question?</div><div style=\"font-size:22px;color:#5A6E78;margin-top:6px\">Email us and we'll answer, and add it here if it helps others.</div></div><a href=\"mailto:hello@taxcoursefinder.com\" style=\"flex:none;background:#0B2E40;color:#fff;font:700 22px Manrope,sans-serif;padding:14px 26px;border-radius:8px\" data-hv=\"10\">hello@taxcoursefinder.com</a></div>\n    </div>\n  </div>\n  \n</div>\n  <sc-if value=\"{{ subOpen }}\" hint-placeholder-val=\"{{ false }}\">\n  <div style=\"position:fixed;right:24px;bottom:24px;z-index:80;width:380px;max-width:calc(100vw - 32px);background:#fff;border:1px solid #D7DFE2;border-radius:18px;box-shadow:0 30px 70px rgba(11,46,64,.28);overflow:hidden;font-family:'Source Sans 3',sans-serif;color:#0B2E40\">\n    <div style=\"height:5px;background:#95AB3B\"></div>\n    <div onclick=\"{{ subClose }}\" title=\"Close\" style=\"position:absolute;top:14px;right:12px;width:36px;height:36px;display:grid;place-items:center;border-radius:8px;cursor:pointer;color:#5A6E78\" data-hv=\"7\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M6 6l12 12M18 6L6 18\"></path></svg></div>\n    <div style=\"padding:26px 26px 24px;display:flex;flex-direction:column;gap:14px\">\n      <div style=\"font:700 15px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">Monthly coupon codes</div>\n      <div style=\"font:800 26px/1.15 Manrope,sans-serif;letter-spacing:-.01em;padding-right:24px\">Get CTEC course coupon codes every month</div>\n      <p style=\"margin:0;font-size:17px;line-height:1.5;color:#5A6E78\">New codes from different course providers each month, plus an alert when a sale starts. No spam, unsubscribe anytime.</p>\n      <sc-if value=\"{{ subDone }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"background:#F3F5E6;border:1px solid #D7EDC8;border-radius:10px;padding:14px 16px;font:700 17px Manrope,sans-serif;color:#7E9330\">You're in. Watch for this month's codes.</div></sc-if>\n      <sc-if value=\"{{ subPending }}\" hint-placeholder-val=\"{{ true }}\">\n      <form onsubmit=\"{{ subSubmit }}\" style=\"display:flex;flex-direction:column;gap:10px\">\n        <input type=\"email\" required=\"\" value=\"{{ subEmail }}\" onchange=\"{{ subChange }}\" placeholder=\"you@example.com\" style=\"height:50px;border:1px solid #D7DFE2;border-radius:10px;padding:0 16px;font:400 17px 'Source Sans 3',sans-serif;color:#0B2E40;outline:none;width:100%;box-sizing:border-box\">\n        <button type=\"submit\" style=\"height:50px;border:0;border-radius:10px;background:#95AB3B;color:#fff;font:700 17px Manrope,sans-serif;cursor:pointer\" data-hv=\"6\">Send me the codes</button>\n      </form>\n      </sc-if>\n      <div style=\"font-size:15px;color:#8A9AA3\">By subscribing you agree to our <a href=\"/privacy-policy/\" style=\"color:#7E9330;font-weight:700\">Privacy Policy</a>.</div>\n    </div>\n  </div>\n  </sc-if>\n</template>",
 "css": "body{margin:0;background:#fff;font-family:\"Source Sans 3\",system-ui,sans-serif;color:#0B2E40}a{color:#7E9330;text-decoration:none}a:hover{color:#7E9330}a:visited{color:#7E9330}a:active{color:#7E9330}a:focus{outline:none}html{scrollbar-gutter:stable}button,select{font:inherit}button:focus,select:focus,input:focus{outline:none}.dd-menu a{display:flex!important;align-items:center;justify-content:space-between;gap:18px}.dd .dd-menu{display:none}.dd:hover .dd-menu,.dd:focus-within .dd-menu{display:block}",
 "ssr": "\n\n\n<div data-screen-label=\"FAQs\" class=\"tcf-screen\">\n  \n  <div style=\"position:relative;overflow:hidden;color:#fff;padding:110px 56px 100px\">\n    <img src=\"/assets/photos/comparing-ctec-courses.webp\" alt=\"\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover\"><div style=\"position:absolute;inset:0;background:linear-gradient(100deg,rgba(11,46,64,.96) 0%,rgba(11,46,64,.88) 55%,rgba(11,46,64,.78) 100%)\"></div>\n      <div style=\"position:absolute;inset:0;background-image:linear-gradient(135deg,rgba(255,255,255,.07) 0%,rgba(255,255,255,0) 55%);\"></div>\n    <div style=\"position:relative;max-width:1200px;margin:0 auto\"><div style=\"display:flex;flex-direction:column;gap:22px;max-width:820px\">\n      <span style=\"align-self:flex-start;border:1px solid rgba(108,190,69,.5);color:#95AB3B;border-radius:999px;padding:7px 14px;font:700 17px Manrope,sans-serif;letter-spacing:.1em;text-transform:uppercase\">Resources</span>\n      <h1 style=\"margin:0;font:300 64px/1.05 Manrope,sans-serif;letter-spacing:-.03em\"><span style=\"display:block\">CTEC Courses</span><span style=\"display:block;font-weight:800\">Frequently Asked <span style=\"color:#95AB3B\">Questions</span></span></h1>\n      <p style=\"margin:0;font-size:22px;line-height:1.55;color:rgba(255,255,255,.82);max-width:640px;text-wrap:pretty\">About CTEC courses, about this site, and about how providers appear here.</p>\n    </div></div>\n  </div>\n  <div style=\"height:6px;background:linear-gradient(90deg,#95AB3B,#7E9330)\"></div>\n  <div style=\"background:#F4F6F7;padding:88px 56px\">\n    <div style=\"max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:48px\">\n      \n        <div style=\"display:grid;grid-template-columns:280px 1fr;gap:48px;align-items:start\">\n          <div style=\"position:sticky;top:134px\"><div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330;margin-bottom:10px\">Requirements</div><h2 style=\"margin:0;font:800 26px/1.15 Manrope,sans-serif;letter-spacing:-.02em\">CTEC courses</h2></div>\n          <div style=\"display:flex;flex-direction:column;gap:12px\"><div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:12px;padding:22px 26px;box-shadow:0 2px 8px rgba(11,46,64,.06)\"><div style=\"font:700 22px Manrope,sans-serif;margin-bottom:8px\">Do I need the 60-hour or the 20-hour course?</div><div style=\"font-size:22px;line-height:1.6;color:#2F4652\">New preparers registering with CTEC for the first time take the 60-hour qualifying course. Registered preparers take 20 hours of continuing education every year to renew.</div></div><div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:12px;padding:22px 26px;box-shadow:0 2px 8px rgba(11,46,64,.06)\"><div style=\"font:700 22px Manrope,sans-serif;margin-bottom:8px\">When is the renewal deadline?</div><div style=\"font-size:22px;line-height:1.6;color:#2F4652\">October 31 each year. Late renewal runs through January 15 with a late fee. After that your registration lapses and you must retake the 60-hour course.</div></div><div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:12px;padding:22px 26px;box-shadow:0 2px 8px rgba(11,46,64,.06)\"><div style=\"font:700 22px Manrope,sans-serif;margin-bottom:8px\">Do I report my own hours to CTEC?</div><div style=\"font-size:22px;line-height:1.6;color:#2F4652\">No. Your provider reports completions to CTEC. Timing varies by provider, so ask the school how soon it reports before you enroll.</div></div><div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:12px;padding:22px 26px;box-shadow:0 2px 8px rgba(11,46,64,.06)\"><div style=\"font:700 22px Manrope,sans-serif;margin-bottom:8px\">Are IRS AFSP hours the same as CTEC hours?</div><div style=\"font-size:22px;line-height:1.6;color:#2F4652\">No, though many providers bundle them. CTEC requires California-specific hours the IRS program does not.</div></div></div>\n        </div>\n      \n        <div style=\"display:grid;grid-template-columns:280px 1fr;gap:48px;align-items:start\">\n          <div style=\"position:sticky;top:134px\"><div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330;margin-bottom:10px\">Using this site</div><h2 style=\"margin:0;font:800 26px/1.15 Manrope,sans-serif;letter-spacing:-.02em\">Comparing providers</h2></div>\n          <div style=\"display:flex;flex-direction:column;gap:12px\"><div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:12px;padding:22px 26px;box-shadow:0 2px 8px rgba(11,46,64,.06)\"><div style=\"font:700 22px Manrope,sans-serif;margin-bottom:8px\">Where do prices come from?</div><div style=\"font-size:22px;line-height:1.6;color:#2F4652\">Provider websites and provider-submitted pricing, checked weekly. Coupon prices are calculated from the listed code and verified before publication.</div></div><div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:12px;padding:22px 26px;box-shadow:0 2px 8px rgba(11,46,64,.06)\"><div style=\"font:700 22px Manrope,sans-serif;margin-bottom:8px\">What does the Verified badge mean?</div><div style=\"font-size:22px;line-height:1.6;color:#2F4652\">An authorized representative has claimed the profile and confirmed its pricing, courses and policies. It is about accuracy, not endorsement.</div></div></div>\n        </div>\n      \n        <div style=\"display:grid;grid-template-columns:280px 1fr;gap:48px;align-items:start\">\n          <div style=\"position:sticky;top:134px\"><div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330;margin-bottom:10px\">For providers</div><h2 style=\"margin:0;font:800 26px/1.15 Manrope,sans-serif;letter-spacing:-.02em\">Schools listed here</h2></div>\n          <div style=\"display:flex;flex-direction:column;gap:12px\"><div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:12px;padding:22px 26px;box-shadow:0 2px 8px rgba(11,46,64,.06)\"><div style=\"font:700 22px Manrope,sans-serif;margin-bottom:8px\">We never signed up. Why are we listed?</div><div style=\"font-size:22px;line-height:1.6;color:#2F4652\">Every CTEC-approved provider is included so students see the whole market. Basic listings are free, and correcting factual errors is always free.</div></div><div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:12px;padding:22px 26px;box-shadow:0 2px 8px rgba(11,46,64,.06)\"><div style=\"font:700 22px Manrope,sans-serif;margin-bottom:8px\">How do we fix incorrect information?</div><div style=\"font-size:22px;line-height:1.6;color:#2F4652\">Use Request a Correction, or email providers@taxcoursefinder.com with the page, what is wrong, the correct information, and a source.</div></div></div>\n        </div>\n      \n      <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:32px 36px;display:flex;align-items:center;justify-content:space-between;gap:32px\"><div><div style=\"font:800 26px/1.2 Manrope,sans-serif\">Still have a question?</div><div style=\"font-size:22px;color:#5A6E78;margin-top:6px\">Email us and we'll answer, and add it here if it helps others.</div></div><a href=\"mailto:hello@taxcoursefinder.com\" style=\"flex:none;background:#0B2E40;color:#fff;font:700 22px Manrope,sans-serif;padding:14px 26px;border-radius:8px\" data-hv=\"10\">hello@taxcoursefinder.com</a></div>\n    </div>\n  </div>\n  \n</div>\n  \n"
}