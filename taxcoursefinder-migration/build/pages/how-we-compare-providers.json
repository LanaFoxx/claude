 "code": "\nclass Component extends DCLogic {\n\n  subTimer = null;\n  subInit() { return;\n    const st = this.state.subState || {};\n    if (localStorage.getItem('tcf_sub_dismissed') || localStorage.getItem('tcf_sub_done')) return;\n    this.subTimer = setTimeout(() => this.setState({ subOpen: true }), 30000);\n  }\n  subVals() {\n    return {\n      subOpen: !!this.state.subOpen, subDone: !!this.state.subDone, subPending: !this.state.subDone, subEmail: this.state.subEmail || '',\n      subChange: ev => this.setState({ subEmail: ev.target.value }),\n      subClose: () => { localStorage.setItem('tcf_sub_dismissed', String(Date.now())); this.setState({ subOpen: false }); },\n      subSubmit: ev => { ev.preventDefault(); localStorage.setItem('tcf_sub_done', '1'); this.setState({ subDone: true }); setTimeout(() => this.setState({ subOpen: false }), 2500); }\n    };\n  }\n  state = { data: null };\n  async componentDidMount() { this.subInit(); this.setState({ data: await TCF.data() }); }\n  renderVals() { const ps = this.state.data ? this.state.data.providers : []; const ds = ps.map(p => p.lastChecked).filter(Boolean).sort(); const lc = ds.length ? new Date(ds[ds.length - 1]) : null; return { ...this.subVals(), lastChecked: lc && !isNaN(lc) ? lc.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'see homepage' }; }\n}\n",
 "props": {},
 "name": "How We Compare Providers",
 "slug": "how-we-compare-providers",
 "url": "/how-we-compare-providers/",
 "title": "How We Compare Providers",
 "runtime": false,
 "rid": "tcf-how-we-compare-providers",
 "widget": "<div class=\"tcf-page tcf-scope tcf-p-how-we-compare-providers\"><div id=\"tcf-how-we-compare-providers-root\" class=\"tcf-root\">@@SSR@@</div></div>\n<template id=\"tcf-how-we-compare-providers-tpl\">\n\n\n<div data-screen-label=\"How We Compare Providers\" class=\"tcf-screen\">\n  \n\n  <div style=\"position:relative;overflow:hidden;color:#fff;padding:110px 56px 100px\">\n    <img src=\"@@MEDIA:photos/comparing-ctec-courses.webp@@\" alt=\"\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover\"><div style=\"position:absolute;inset:0;background:linear-gradient(100deg,rgba(11,46,64,.96) 0%,rgba(11,46,64,.88) 55%,rgba(11,46,64,.78) 100%)\"></div>\n      <div style=\"position:absolute;inset:0;background-image:linear-gradient(135deg,rgba(255,255,255,.07) 0%,rgba(255,255,255,0) 55%);\"></div>\n    <div style=\"position:relative;max-width:1200px;margin:0 auto\"><div style=\"display:flex;flex-direction:column;gap:20px;max-width:820px\">\n      <span style=\"align-self:flex-start;border:1px solid rgba(108,190,69,.5);color:#95AB3B;border-radius:999px;padding:7px 14px;font:700 17px Manrope,sans-serif;letter-spacing:.1em;text-transform:uppercase\">Our method</span>\n      <h1 style=\"margin:0;font:300 52px/1.05 Manrope,sans-serif;letter-spacing:-.03em\"><span style=\"display:block\">How we</span><span style=\"display:block;font-weight:800\">compare <span style=\"color:#95AB3B\">providers</span></span></h1>\n      <p style=\"margin:0;font-size:22px;line-height:1.55;color:#fff;max-width:640px;text-wrap:pretty\">Tax Course Finder lists every CTEC-approved education provider and shows the same facts for each. We do not score, rank or recommend schools. The order you see is the sort you choose.</p>\n    </div></div>\n  </div>\n  <div style=\"height:6px;background:linear-gradient(90deg,#95AB3B,#7E9330)\"></div>\n  <div style=\"background:#F4F6F7;padding:72px 56px\">\n    <div style=\"max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:28px\">\n      <div style=\"max-width:820px\"><div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">What is on every listing</div><h2 style=\"margin:10px 0 0;font:300 52px/1.1 Manrope,sans-serif;letter-spacing:-.02em\">The same facts, <span style=\"font-weight:800\">the same way</span></h2><p style=\"margin:0;font-size:22px;line-height:1.65;color:#2F4652;text-wrap:pretty;margin-top:14px\">Each provider row shows the details below when we have verified them. A blank field means we have not confirmed it yet; it does not mean the provider lacks the feature.</p></div>\n      <div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px\">\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:28px 30px;display:flex;flex-direction:column;gap:10px\"><div style=\"font:800 22px Manrope,sans-serif;color:#0B2E40\">CTEC approval</div><p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">Every school is matched to CTEC’s approved-provider registry before it appears, and we show which course types (20-hour CE, 60-hour QE) the approval covers.</p></div>\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:28px 30px;display:flex;flex-direction:column;gap:10px\"><div style=\"font:800 22px Manrope,sans-serif;color:#0B2E40\">Published price</div><p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">The price shown on the provider’s own website for the complete course. Where a school publishes no flat price, the row says so instead of estimating.</p></div>\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:28px 30px;display:flex;flex-direction:column;gap:10px\"><div style=\"font:800 22px Manrope,sans-serif;color:#0B2E40\">Current offers</div><p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">Coupon codes and sales are recorded only when found on the provider’s site or supplied by the provider, with the date checked. Expired offers are removed.</p></div>\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:28px 30px;display:flex;flex-direction:column;gap:10px\"><div style=\"font:800 22px Manrope,sans-serif;color:#0B2E40\">Course format</div><p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">Online, self-paced, live instruction, video, text and printed materials, shown once confirmed by the provider or our review.</p></div>\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:28px 30px;display:flex;flex-direction:column;gap:10px\"><div style=\"font:800 22px Manrope,sans-serif;color:#0B2E40\">Support and access</div><p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">Support channels, mobile access and similar features, displayed only when verified.</p></div>\n        <div style=\"background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:28px 30px;display:flex;flex-direction:column;gap:10px\"><div style=\"font:800 22px Manrope,sans-serif;color:#0B2E40\">Website link</div><p style=\"margin:0;font-size:22px;line-height:1.6;color:#2F4652\">A direct link to the provider’s site. You enroll with the school, not with us.</p></div>\n      </div>\n    </div>\n  </div>\n  <div style=\"background:#fff;padding:72px 56px\">\n    <div style=\"max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start\">\n      <div style=\"display:flex;flex-direction:column;gap:14px\"><div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">Ordering</div><h2 style=\"margin:0;font:300 52px/1.1 Manrope,sans-serif;letter-spacing:-.02em\">No rankings. <span style=\"font-weight:800\">You choose the sort.</span></h2><p style=\"margin:0;font-size:22px;line-height:1.65;color:#2F4652;text-wrap:pretty\">Listings default to alphabetical order. You can sort by published price or filter by course type and verified features. No provider can pay to move up, and we publish no editorial score.</p><p style=\"margin:0;font-size:22px;line-height:1.65;color:#2F4652;text-wrap:pretty\">If we later add ratings or reviews, this page will describe exactly how they are gathered before they appear on the site.</p></div>\n      <div style=\"display:flex;flex-direction:column;gap:14px\"><div style=\"font:700 17px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">Checking</div><h2 style=\"margin:0;font:300 52px/1.1 Manrope,sans-serif;letter-spacing:-.02em\">What we check, <span style=\"font-weight:800\">and when</span></h2><p style=\"margin:0;font-size:22px;line-height:1.65;color:#2F4652;text-wrap:pretty\">Prices, offers and approval status are reviewed against provider websites and the CTEC registry on each data review. The date of the most recent completed review is shown on the homepage and on this page: <strong style=\"color:#0B2E40\">{{ lastChecked }}</strong>.</p><p style=\"margin:0;font-size:22px;line-height:1.65;color:#2F4652;text-wrap:pretty\">Providers can verify or correct their own listing at no charge through <a href=\"/provider-application/\" style=\"color:#7E9330;font-weight:700\">Verify your profile</a> or <a href=\"/provider-rights/#correction\" style=\"color:#7E9330;font-weight:700\">Request a correction</a>.</p></div>\n    </div>\n  </div>\n  <div style=\"background:#F4F6F7;padding:56px 56px 72px\"><div style=\"max-width:1200px;margin:0 auto;background:#fff;border:1px solid #D7DFE2;border-radius:16px;padding:22px 28px;font-size:19px;line-height:1.6;color:#5A6E78\">Tax Course Finder is an independent comparison website and is not affiliated with CTEC or with any listed provider. Confirm course details and approval on the provider’s site and at <a href=\"https://ctec.org/taxpreparers/find-education-provider/\" target=\"_blank\" rel=\"noopener\" style=\"color:#7E9330;font-weight:700\">CTEC.org</a> before enrolling.</div></div>\n  \n</div>\n  <sc-if value=\"{{ subOpen }}\" hint-placeholder-val=\"{{ false }}\">\n  <div style=\"position:fixed;right:24px;bottom:24px;z-index:80;width:380px;max-width:calc(100vw - 32px);background:#fff;border:1px solid #D7DFE2;border-radius:18px;box-shadow:0 30px 70px rgba(11,46,64,.28);overflow:hidden;font-family:'Source Sans 3',sans-serif;color:#0B2E40\">\n    <div style=\"height:5px;background:#95AB3B\"></div>\n    <div onclick=\"{{ subClose }}\" title=\"Close\" style=\"position:absolute;top:14px;right:12px;width:36px;height:36px;display:grid;place-items:center;border-radius:8px;cursor:pointer;color:#5A6E78\" data-hv=\"7\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M6 6l12 12M18 6L6 18\"></path></svg></div>\n    <div style=\"padding:26px 26px 24px;display:flex;flex-direction:column;gap:14px\">\n      <div style=\"font:700 15px Manrope,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#7E9330\">Monthly coupon codes</div>\n      <div style=\"font:800 26px/1.15 Manrope,sans-serif;letter-spacing:-.01em;padding-right:24px\">Get CTEC course coupon codes every month</div>\n      <p style=\"margin:0;font-size:17px;line-height:1.5;color:#5A6E78\">New codes from different course providers each month, plus an alert when a sale starts. No spam, unsubscribe anytime.</p>\n      <sc-if value=\"{{ subDone }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"background:#F3F5E6;border:1px solid #D7EDC8;border-radius:10px;padding:14px 16px;font:700 17px Manrope,sans-serif;color:#7E9330\">You're in. Watch for this month's codes.</div></sc-if>\n      <sc-if value=\"{{ subPending }}\" hint-placeholder-val=\"{{ true }}\">\n      <form onsubmit=\"{{ subSubmit }}\" style=\"display:flex;flex-direction:column;gap:10px\">\n        <input type=\"email\" required=\"\" value=\"{{ subEmail }}\" onchange=\"{{ subChange }}\" placeholder=\"you@example.com\" style=\"height:50px;border:1px solid #D7DFE2;border-radius:10px;padding:0 16px;font:400 17px 'Source Sans 3',sans-serif;color:#0B2E40;outline:none;width:100%;box-sizing:border-box\">\n        <button type=\"submit\" style=\"height:50px;border:0;border-radius:10px;background:#95AB3B;color:#fff;font:700 17px Manrope,sans-serif;cursor:pointer\" data-hv=\"6\">Send me the codes</button>\n      </form>\n      </sc-if>\n      <div style=\"font-size:15px;color:#8A9AA3\">By subscribing you agree to our <a href=\"/privacy-policy/\" style=\"color:#7E9330;font-weight:700\">Privacy Policy</a>.</div>\n    </div>\n  </div>\n  </sc-if>\n</template>",
 "css": "body{margin:0;background:#fff;font-family:\"Source Sans 3\",system-ui,sans-serif;color:#0B2E40}a{color:#7E9330;text-decoration:none}a:hover{color:#7E9330}a:visited{color:#7E9330}a:active{color:#7E9330}a:focus{outline:none}html{scrollbar-gutter:stable}button,select{font:inherit}button:focus,select:focus,input:focus{outline:none}.dd-menu a{display:flex!important;align-items:center;justify-content:space-between;gap:18px}.dd .dd-menu{display:none}.dd:hover .dd-menu,.dd:focus-within .dd-menu{display:block}",
