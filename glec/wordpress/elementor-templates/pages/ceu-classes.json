{"content": [{"id": "306be5c", "elType": "container", "isInner": false, "settings": {"content_width": "boxed", "flex_direction": "column", "flex_gap": {"column": "0", "row": "0", "isLinked": true, "unit": "px", "size": 0}, "padding": {"unit": "px", "top": "72", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "boxed_width": {"unit": "px", "size": 1312, "sizes": []}, "padding_tablet": {"unit": "px", "top": "56", "right": "40", "bottom": "64", "left": "40", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "40", "right": "20", "bottom": "48", "left": "20", "isLinked": false}, "css_classes": "g-phero g-tex-navy g-on-navy", "background_background": "classic", "__globals__": {"background_color": "globals/colors?id=navy"}, "html_tag": "section"}, "elements": [{"id": "4f8a4d9", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "16", "row": "16", "isLinked": true, "unit": "px", "size": 16}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap_mobile": {"column": "12", "row": "12", "isLinked": true, "unit": "px", "size": 12}, "css_classes": "g-phero__in"}, "elements": [{"id": "fa8f749", "elType": "widget", "widgetType": "html", "isInner": false, "settings": {"html": "<nav class=\"g-crumbs\" aria-label=\"Breadcrumb\"><ol><li><a href=\"https://staging158.dreamweb.digital/\">Home</a></li><li aria-current=\"page\">CEU classes</li></ol></nav>"}, "elements": []}, {"id": "3eb705f", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "Continuing education units", "header_size": "div", "__globals__": {"title_color": "globals/colors?id=line", "typography_typography": "globals/typography?id=eyebrow"}, "_css_classes": "g-eyebrow g-eyebrow-light"}, "elements": []}, {"id": "d3b32fc", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "CEU classes", "header_size": "h1", "__globals__": {"title_color": "globals/colors?id=white"}, "typography_typography": "custom", "typography_font_size": {"unit": "px", "size": 56, "sizes": []}, "typography_font_size_mobile": {"unit": "px", "size": 36, "sizes": []}, "_css_classes": "g-ph1"}, "elements": []}, {"id": "058eb1f", "elType": "widget", "widgetType": "text-editor", "isInner": false, "settings": {"editor": "<p>Board-approved CEU classes for Georgia Conditioned Air contractors. All CEU classes are online only.</p>", "__globals__": {"typography_typography": "globals/typography?id=lead", "text_color": "globals/colors?id=line"}, "_css_classes": "g-plead"}, "elements": []}]}]}, {"id": "a3c952a", "elType": "container", "isInner": false, "settings": {"content_width": "boxed", "flex_direction": "column", "flex_gap": {"column": "40", "row": "40", "isLinked": true, "unit": "px", "size": 40}, "padding": {"unit": "px", "top": "104", "right": "64", "bottom": "104", "left": "64", "isLinked": false}, "boxed_width": {"unit": "px", "size": 1312, "sizes": []}, "flex_gap_mobile": {"column": "28", "row": "28", "isLinked": true, "unit": "px", "size": 28}, "padding_tablet": {"unit": "px", "top": "80", "right": "40", "bottom": "80", "left": "40", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "64", "right": "20", "bottom": "64", "left": "20", "isLinked": false}, "html_tag": "section"}, "elements": [{"id": "8551790", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "64", "row": "64", "isLinked": true, "unit": "px", "size": 64}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap_mobile": {"column": "32", "row": "32", "isLinked": true, "unit": "px", "size": 32}, "css_classes": "g-g2 g-ceuintro"}, "elements": [{"id": "db990c6", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "16", "row": "16", "isLinked": true, "unit": "px", "size": 16}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "a53de01", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "What the Board requires", "header_size": "h2", "__globals__": {"title_color": "globals/colors?id=navy", "typography_typography": "globals/typography?id=h2"}}, "elements": []}, {"id": "1917b3f", "elType": "widget", "widgetType": "text-editor", "isInner": false, "settings": {"editor": "<ul class=\"g-list\"><li>The Conditioned Air Contractors Licensing Board requires four (4) CEUs per year, due by December 31 of odd-numbered years, for example 2027, 2029 and 2031. That equals 8 hours every two years.</li><li>You must keep your certificates on file for 5 years plus the last renewal period. Just keep them 7 years.</li></ul>", "__globals__": {"typography_typography": "globals/typography?id=body", "text_color": "globals/colors?id=ink"}, "_css_classes": "g-prose "}, "elements": []}]}, {"id": "0e806d3", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "16", "row": "16", "isLinked": true, "unit": "px", "size": 16}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "3602b8b", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "How every CEU class works", "header_size": "h2", "__globals__": {"title_color": "globals/colors?id=navy", "typography_typography": "globals/typography?id=h2"}}, "elements": []}, {"id": "1039f05", "elType": "widget", "widgetType": "html", "isInner": false, "settings": {"html": "<ul class=\"g-tick\"><li><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>The CEU classes GLEC offers are approved by the Conditioned Air Licensing Board.</li><li><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>Older CEU videos are about 10 to 15 minutes long; recent ones are about 3 to 8 minutes.</li><li><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>There are no formal quizzes to take and pass.</li><li><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>You are monitored online for the required four (4) hours, to make sure you watch every minute of each video.</li><li><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>Do not fast-forward or skip any part of a video, or you will have to watch it again until you have watched every second.</li><li><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>You must complete the whole class to print your certificate of completion.</li><li><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>Print your certificate as soon as you finish all the class videos. We suggest printing 2 or 3 copies.</li><li><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>Also save the certificate as a PDF on your computer or a memory device: you will need to upload it with your application to the Board.</li></ul>"}, "elements": []}]}]}, {"id": "c648976", "elType": "widget", "widgetType": "html", "isInner": false, "settings": {"html": "<div class=\"g-callout g-callout--info\"><span class=\"g-callout__ico\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 16v-4M12 8h.01\"/></svg></span><div><p class=\"g-callout__t\">Access</p><p>Online CEU classes are available 24/7, as many times as you like, through your completion. You have 4 months to complete each class.</p></div></div>"}, "elements": []}]}, {"id": "8b8691b", "elType": "container", "isInner": false, "settings": {"content_width": "boxed", "flex_direction": "column", "flex_gap": {"column": "40", "row": "40", "isLinked": true, "unit": "px", "size": 40}, "padding": {"unit": "px", "top": "104", "right": "64", "bottom": "104", "left": "64", "isLinked": false}, "boxed_width": {"unit": "px", "size": 1312, "sizes": []}, "flex_gap_mobile": {"column": "28", "row": "28", "isLinked": true, "unit": "px", "size": 28}, "padding_tablet": {"unit": "px", "top": "80", "right": "40", "bottom": "80", "left": "40", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "64", "right": "20", "bottom": "64", "left": "20", "isLinked": false}, "background_background": "classic", "__globals__": {"background_color": "globals/colors?id=mist"}, "html_tag": "section"}, "elements": [{"id": "9434353", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "8", "row": "8", "isLinked": true, "unit": "px", "size": 8}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "86b6437", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "Choose a CEU class", "header_size": "h2", "__globals__": {"title_color": "globals/colors?id=navy", "typography_typography": "globals/typography?id=h2"}}, "elements": []}, {"id": "5f5aa47", "elType": "widget", "widgetType": "text-editor", "isInner": false, "settings": {"editor": "<p>Select a class to see what it covers.</p>", "__globals__": {"typography_typography": "globals/typography?id=body", "text_color": "globals/colors?id=slate"}}, "elements": []}]}, {"id": "d75e86d", "elType": "widget", "widgetType": "html", "isInner": false, "settings": {"html": "<div class=\"g-ceulist\"><details class=\"g-ceu\"><summary><span class=\"g-ceu__code\">CARRIER-CEU (2027)</span><span class=\"g-ceu__name\">Carrier Commercial Design: examples</span><span class=\"g-ceu__hrs\">4 hours</span><span class=\"g-ceu__price\">$50</span><span class=\"g-ceu__chev\" aria-hidden=\"true\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></span></summary><div class=\"g-ceu__body\"><ul class=\"g-list\"><li>Covers many of the examples in the Carrier manuals: 1, Load Estimating; 2, Air Distribution; 3, Piping Design.</li><li>You should have these manuals to follow along with the videos.</li><li>18 videos, usually 5 to 8 minutes long.</li></ul><div class=\"g-ceu__buy\"><a href=\"?add-to-cart=632\" data-quantity=\"1\" data-product_id=\"632\" class=\"button add_to_cart_button ajax_add_to_cart g-ceu__atc\" aria-label=\"Add CARRIER-CEU to your cart\" rel=\"nofollow\">Add to cart</a></div></div></details><details class=\"g-ceu\"><summary><span class=\"g-ceu__code\">EPA-MOLD-CEU (2027)</span><span class=\"g-ceu__name\">EPA Mold Remediation: an HVAC perspective</span><span class=\"g-ceu__hrs\">4 hours</span><span class=\"g-ceu__price\">$50</span><span class=\"g-ceu__chev\" aria-hidden=\"true\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></span></summary><div class=\"g-ceu__body\"><ul class=\"g-list\"><li>Mold in schools and commercial buildings, from an HVAC perspective: an overview of mold prevention and mold remediation, based on the EPA&rsquo;s voluntary guidance document <i>Mold Remediation in Schools and Commercial Buildings</i>.</li><li>For building managers, custodians, remediators, contractors and other professionals who respond to mold problems.</li><li>Covers mold types and growth, humidity and moisture, moisture migration, permeance, odor and ventilation, how and where to locate mold, response time, and remedial techniques.</li></ul><div class=\"g-ceu__buy\"><a href=\"?add-to-cart=633\" data-quantity=\"1\" data-product_id=\"633\" class=\"button add_to_cart_button ajax_add_to_cart g-ceu__atc\" aria-label=\"Add EPA-MOLD-CEU to your cart\" rel=\"nofollow\">Add to cart</a></div></div></details><details class=\"g-ceu\"><summary><span class=\"g-ceu__code\">HELIX-SIZING-CEU (2027)</span><span class=\"g-ceu__name\">Wire Helix Trunk &amp; Branch Duct Sizing</span><span class=\"g-ceu__hrs\">4 hours</span><span class=\"g-ceu__price\">$50</span><span class=\"g-ceu__chev\" aria-hidden=\"true\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></span></summary><div class=\"g-ceu__body\"><ul class=\"g-list\"><li>Figure 9-1 from ACCA Manual D, 3rd edition (version 2.50).</li><li>Learn more about duct sizing, especially wire helix flex duct: comparing flex duct sizes to sheet metal duct sizes, and other considerations, so you feel comfortable designing for it.</li><li>The book is not required to follow along. 17 videos.</li></ul><div class=\"g-ceu__buy\"><a href=\"?add-to-cart=634\" data-quantity=\"1\" data-product_id=\"634\" class=\"button add_to_cart_button ajax_add_to_cart g-ceu__atc\" aria-label=\"Add HELIX-SIZING-CEU to your cart\" rel=\"nofollow\">Add to cart</a></div></div></details><details class=\"g-ceu\"><summary><span class=\"g-ceu__code\">FLEX-DUCT-CEU (2027)</span><span class=\"g-ceu__name\">ADC Flex Duct Performance &amp; Installation Standards</span><span class=\"g-ceu__hrs\">1 hour</span><span class=\"g-ceu__price\">$15</span><span class=\"g-ceu__chev\" aria-hidden=\"true\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></span></summary><div class=\"g-ceu__body\"><ul class=\"g-list\"><li>For installers, service techs and others: styles, material characteristics, listing requirements, performance, testing methods, product certification, marking and packaging, installation requirements and limitations, duct sizing, duct leakage, and safety.</li><li>For those who need just one CEU hour to reach the 4 hours a year needed to renew.</li><li>Reference: ADC Flexible Duct Performance &amp; Installation Standards, 5th edition (2010). Not required to follow along. 6 videos, monitored online for the one hour.</li></ul><div class=\"g-ceu__buy\"><a href=\"?add-to-cart=635\" data-quantity=\"1\" data-product_id=\"635\" class=\"button add_to_cart_button ajax_add_to_cart g-ceu__atc\" aria-label=\"Add FLEX-DUCT-CEU to your cart\" rel=\"nofollow\">Add to cart</a></div></div></details><details class=\"g-ceu\"><summary><span class=\"g-ceu__code\">2018-CODE-CHANGES-CEU (2027)</span><span class=\"g-ceu__name\">2018 Code Changes: IFGC &amp; IMC</span><span class=\"g-ceu__hrs\">4 hours</span><span class=\"g-ceu__price\">$50</span><span class=\"g-ceu__chev\" aria-hidden=\"true\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></span></summary><div class=\"g-ceu__body\"><ul class=\"g-list\"><li>Reviews the 2015 and 2018 changes in the 2018 International Fuel Gas Code and International Mechanical Code, shown directly in the code books with yellow highlighting, and red tags marking the 2015 changes.</li><li>Also reviews the State of Georgia 2020 amendments for the 2018 IFGC and IMC. After payment, download the Georgia amendments from our website.</li><li>Code books are not required to follow along. 14 videos.</li></ul><div class=\"g-ceu__buy\"><a href=\"?add-to-cart=636\" data-quantity=\"1\" data-product_id=\"636\" class=\"button add_to_cart_button ajax_add_to_cart g-ceu__atc\" aria-label=\"Add 2018-CODE-CHANGES-CEU to your cart\" rel=\"nofollow\">Add to cart</a></div></div></details><details class=\"g-ceu\"><summary><span class=\"g-ceu__code\">2021-CODE-CHANGES-CEU (2027)</span><span class=\"g-ceu__name\">2021 Code Changes: IFGC &amp; IMC</span><span class=\"g-ceu__hrs\">4 hours</span><span class=\"g-ceu__price\">$50</span><span class=\"g-ceu__chev\" aria-hidden=\"true\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></span></summary><div class=\"g-ceu__body\"><ul class=\"g-list\"><li>Georgia&rsquo;s Department of Community Affairs updates the code books every 6 years, while the ICC changes them every 3. Code officials in various jurisdictions are already requiring several of the newer changes for safety, health and operation. As a professional contractor, it is best to know what is coming.</li><li>Reviews a third-party book that explains each code change, with comments, diagrams and reasons. Code books are not required to follow along.</li><li>38 videos, 3 to 8 minutes long.</li></ul><div class=\"g-ceu__buy\"><a href=\"?add-to-cart=637\" data-quantity=\"1\" data-product_id=\"637\" class=\"button add_to_cart_button ajax_add_to_cart g-ceu__atc\" aria-label=\"Add 2021-CODE-CHANGES-CEU to your cart\" rel=\"nofollow\">Add to cart</a></div></div></details><details class=\"g-ceu\"><summary><span class=\"g-ceu__code\">2024-CODE-CHANGES-CEU (2027)</span><span class=\"g-ceu__name\">2024 Code Changes: IFGC &amp; IMC</span><span class=\"g-ceu__hrs\">4 hours</span><span class=\"g-ceu__price\">$50</span><span class=\"g-ceu__chev\" aria-hidden=\"true\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></span></summary><div class=\"g-ceu__body\"><ul class=\"g-list\"><li>Reviews the 2024 code changes in the IFGC and IMC code books, through a third-party book that explains each change with comments, diagrams and reasons.</li><li>For contractors needing 4 CEU hours a year to renew. This class does not meet the requirements for a Conditioned Air license application.</li><li>Code books are not required to follow along. 48 videos, 3 to 8 minutes long.</li></ul><div class=\"g-ceu__buy\"><a href=\"?add-to-cart=638\" data-quantity=\"1\" data-product_id=\"638\" class=\"button add_to_cart_button ajax_add_to_cart g-ceu__atc\" aria-label=\"Add 2024-CODE-CHANGES-CEU to your cart\" rel=\"nofollow\">Add to cart</a></div></div></details></div>"}, "elements": []}]}], "page_settings": {"hide_title": "yes"}, "version": "0.4", "title": "CEU classes", "type": "page"}