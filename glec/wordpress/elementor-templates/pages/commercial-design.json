16", "isLinked": true, "unit": "px", "size": 16}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "fbe78a1", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "Why you need it", "header_size": "h2", "__globals__": {"title_color": "globals/colors?id=navy", "typography_typography": "globals/typography?id=h2"}}, "elements": []}, {"id": "46a6418", "elType": "widget", "widgetType": "text-editor", "isInner": false, "settings": {"editor": "<p>A Board rule from 2005 requires you to submit this Commercial Design Class certificate of completion with your Conditioned Air license application. The License Board will not process your application without it.</p><p>This certificate of completion is required for Non-Restricted (Class 2) license applicants only.</p>", "__globals__": {"typography_typography": "globals/typography?id=body", "text_color": "globals/colors?id=ink"}, "_css_classes": "g-prose "}, "elements": []}]}, {"id": "523ad82", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "16", "row": "16", "isLinked": true, "unit": "px", "size": 16}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "522732a", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "What it covers", "header_size": "h2", "__globals__": {"title_color": "globals/colors?id=navy", "typography_typography": "globals/typography?id=h2"}}, "elements": []}, {"id": "63d2fd4", "elType": "widget", "widgetType": "text-editor", "isInner": false, "settings": {"editor": "<p>The certificate of completion requires 8 hours of class time, covering the Carrier System Design Manuals 1, 2 and 3. These books cover the commercial heat loss/gain and duct design calculations.</p>", "__globals__": {"typography_typography": "globals/typography?id=body", "text_color": "globals/colors?id=ink"}, "_css_classes": "g-prose "}, "elements": []}]}, {"id": "d4535ee", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "16", "row": "16", "isLinked": true, "unit": "px", "size": 16}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "c662ecf", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "Good to know", "header_size": "h2", "__globals__": {"title_color": "globals/colors?id=navy", "typography_typography": "globals/typography?id=h2"}}, "elements": []}, {"id": "90a2b32", "elType": "widget", "widgetType": "text-editor", "isInner": false, "settings": {"editor": "<ul class=\"g-list\"><li>You are responsible for buying the required reference books for the classes you purchase. <a href=\"https://sebookstore.com/glec.html\" target=\"_blank\" rel=\"noopener\">Order the reference books</a>.</li><li>Print your certificate of completion online after watching all the videos. Print 3 copies and save one as a PDF for your application.</li><li>This class can be used for your NATE CEHs. Submit a copy of your certificate to NATE at your renewal.</li></ul>", "__globals__": {"typography_typography": "globals/typography?id=body", "text_color": "globals/colors?id=ink"}, "_css_classes": "g-prose "}, "elements": []}]}, {"id": "e579d8e", "elType": "widget", "widgetType": "html", "isInner": false, "settings": {"html": "<div class=\"g-callout g-callout--info\"><span class=\"g-callout__ico\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 16v-4M12 8h.01\"/></svg></span><div><p class=\"g-callout__t\">Access</p><p>Available on demand, 24/7, as many times as you like: up to one year after the date you buy the class, or until you pass your exam, whichever comes first. Access can be extended if needed for a fair fee, based on how long it has been since you bought it.</p></div></div>"}, "elements": []}]}, {"id": "ce09106", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "0", "row": "0", "isLinked": true, "unit": "px", "size": 0}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "css_classes": "g-aside"}, "elements": [{"id": "8cb8a7d", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "16", "row": "16", "isLinked": true, "unit": "px", "size": 16}, "padding": {"unit": "px", "top": "28", "right": "28", "bottom": "28", "left": "28", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "22", "right": "20", "bottom": "22", "left": "20", "isLinked": false}, "css_classes": "g-buy"}, "elements": [{"id": "dbd43e5", "elType": "widget", "widgetType": "html", "isInner": false, "settings": {"html": "<span class=\"g-code\">HLG-DD-C-OL</span>"}, "elements": []}, {"id": "940161d", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "$", "header_size": "span", "__globals__": {}, "__dynamic__": {"title": "[elementor-tag id=\"f6b91d1\" name=\"woocommerce-product-price-tag\" settings=\"%7B%22product_id%22%3A%20%22539%22%2C%20%22format%22%3A%20%22original%22%7D\"]"}, "_css_classes": "g-num g-pricebig g-buy__price"}, "elements": []}, {"id": "1988c9f", "elType": "widget", "widgetType": "text-editor", "isInner": false, "settings": {"editor": "<p class=\"g-buy__note\">Non-Restricted only</p>", "__globals__": {}}, "elements": []}, {"id": "3df561e", "elType": "widget", "widgetType": "wc-add-to-cart", "isInner": false, "settings": {"product_id": "539", "text": "Add to cart", "show_quantity": "", "align": "left", "selected_i