x_gap": {"column": "16", "row": "16", "isLinked": true, "unit": "px", "size": 16}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "46a6418", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "Why you should buy this class", "header_size": "h2", "__globals__": {"title_color": "globals/colors?id=navy", "typography_typography": "globals/typography?id=h2"}}, "elements": []}, {"id": "76688e7", "elType": "widget", "widgetType": "text-editor", "isInner": false, "settings": {"editor": "<p>A Board rule from 2005 requires you to submit this Commercial Design Class Certificate of Completion with your Conditioned Air license application. The License Board will not process your application without it.</p><p>This Certificate of Completion is required for Non-Restricted (Class 2) license applicants only.</p>", "__globals__": {"typography_typography": "globals/typography?id=body", "text_color": "globals/colors?id=ink"}, "_css_classes": "g-prose "}, "elements": []}]}, {"id": "c662ecf", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "16", "row": "16", "isLinked": true, "unit": "px", "size": 16}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "63d2fd4", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "What it covers", "header_size": "h2", "__globals__": {"title_color": "globals/colors?id=navy", "typography_typography": "globals/typography?id=h2"}}, "elements": []}, {"id": "523ad82", "elType": "widget", "widgetType": "text-editor", "isInner": false, "settings": {"editor": "<p>The Certificate of Completion requires 8 hours of class time, covering the Carrier System Design Manuals 1, 2 and 3. These books cover the commercial heat loss/gain and duct design calculations.</p>", "__globals__": {"typography_typography": "globals/typography?id=body", "text_color": "globals/colors?id=ink"}, "_css_classes": "g-prose "}, "elements": []}]}, {"id": "e579d8e", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "16", "row": "16", "isLinked": true, "unit": "px", "size": 16}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "90a2b32", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "Good to know", "header_size": "h2", "__globals__": {"title_color": "globals/colors?id=navy", "typography_typography": "globals/typography?id=h2"}}, "elements": []}, {"id": "d4535ee", "elType": "widget", "widgetType": "text-editor", "isInner": false, "settings": {"editor": "<ul class=\"g-list\"><li>You are responsible for buying the required Reference Books for the classes you purchase. <a href=\"https://sebookstore.com/glec.html\" target=\"_blank\" rel=\"noopener\">Order the Reference Books</a>.</li><li>Print your Certificate of Completion online after watching all the videos. Print 3 copies and save one as a PDF for your application.</li><li>This class can be used for your NATE CEHs. Submit a copy of your certificate to NATE at your renewal.</li></ul>", "__globals__": {"typography_typography": "globals/typography?id=body", "text_color": "globals/colors?id=ink"}, "_css_classes": "g-prose "}, "elements": []}]}, {"id": "6aeb7e9", "elType": "widget", "widgetType": "html", "isInner": false, "settings": {"html": "<details class=\"g-more\"><summary>See More <span aria-hidden=\"true\">+</span></summary><div class=\"g-more__body\"><p>This class is also known as &ldquo;The Commercial Heat Loss/Gain &amp; Duct Design Class&rdquo;.</p><p>Board Rule from the year 2005 requires you to submit this Commercial Design Class Certificate of Completion with your &ldquo;CA&rdquo; Conditioned Air License Application. The License Board will NOT process your Application without it!</p><p>This Certificate of Completion is required to APPLY for the Non-Restricted (Class 2) License applicants only.</p><p>Certificate of Completion requires 8 hours of class time, covering the Carrier System Design Manuals 1, 2, 3. These Books are to cover the Commercial Heat Loss/Gain &amp; Duct Design calculations.</p><p>You are responsible for Purchasing all the required Reference Books for the classes you purchased. Go to Quick Links to find the Reference Book list, and to also Purchase Order the Books.</p><p>You would Print your Certificate of Completion Online, after watching all the videos. Print 3 copies and one as a PDF for your Application.</p><p>NATE: This class could be used for your NATE CEH&rsquo;s. You would have to submit a copy of your Certificate to NATE at your Renewal.</p><p>Available On-Demand 24/7 As many times, through your Exam, up to one year after your date of purchase of the class, or until you pass your Exam, whichever comes first. Can be extended if needed, for a fair fee, based on length of time from purchase date.</p></div></details>"}, "elements": []}, {"id": "ebbbc02", "elType": "widget", "widgetType": "html", "isInner": false, "settings": {"html": "<div class=\"g-callout g-callout--info\"><span class=\"g-callout__ico\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 16v-4M12 8h.01\"/></svg></span><div><p class=\"g-callout__t\">Access</p><p>Available on demand, 24/7, as many times as you like: up to one year after the date you buy the class, or until you pass your exam, whichever comes first. Access can be extended if needed for a fair fee, based on how long it has been since you bought it.</p></div></div>"}, "elements": []}]}, {"id": "377d610", "elType": "container", "isInner": false, "setti