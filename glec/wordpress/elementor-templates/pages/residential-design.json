navy", "typography_typography": "globals/typography?id=h2"}, "typography_typography": "custom", "typography_font_size": {"unit": "px", "size": 32, "sizes": []}, "typography_font_size_mobile": {"unit": "px", "size": 26, "sizes": []}}, "elements": []}, {"id": "562c532", "elType": "widget", "widgetType": "text-editor", "isInner": false, "settings": {"editor": "<p>Going for the Non-Restricted (Class 2) license? You also need the Commercial Design Class. Restricted applicants can skip ahead to the application.</p>", "__globals__": {"typography_typography": "globals/typography?id=body", "text_color": "globals/colors?id=slate"}}, "elements": []}, {"id": "b94795a", "elType": "widget", "widgetType": "button", "isInner": false, "settings": {"text": "Continue", "link": {"url": "https://staging158.dreamweb.digital/license-classes/commercial-design/", "is_external": "", "nofollow": ""}, "align": "left", "_css_classes": "g-btn"}, "elements": []}]}]}]}