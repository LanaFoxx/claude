{"content": [{"id": "09a813b", "elType": "container", "isInner": false, "settings": {"content_width": "boxed", "flex_direction": "column", "flex_gap": {"column": "0", "row": "0", "isLinked": true, "unit": "px", "size": 0}, "padding": {"unit": "px", "top": "72", "right": "64", "bottom": "80", "left": "64", "isLinked": false}, "boxed_width": {"unit": "px", "size": 1312, "sizes": []}, "padding_tablet": {"unit": "px", "top": "56", "right": "40", "bottom": "64", "left": "40", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "40", "right": "20", "bottom": "48", "left": "20", "isLinked": false}, "css_classes": "g-phero g-tex-navy g-on-navy", "background_background": "classic", "__globals__": {"background_color": "globals/colors?id=navy"}, "html_tag": "section"}, "elements": [{"id": "3d30027", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "16", "row": "16", "isLinked": true, "unit": "px", "size": 16}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap_mobile": {"column": "12", "row": "12", "isLinked": true, "unit": "px", "size": 12}, "css_classes": "g-phero__in"}, "elements": [{"id": "e2e5179", "elType": "widget", "widgetType": "html", "isInner": false, "settings": {"html": "<nav class=\"g-crumbs\" aria-label=\"Breadcrumb\"><ol><li><a href=\"https://staging158.dreamweb.digital/\">Home</a></li><li aria-current=\"page\">About</li></ol></nav>"}, "elements": []}, {"id": "59f8f7e", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "About GLEC", "header_size": "div", "__globals__": {"title_color": "globals/colors?id=line", "typography_typography": "globals/typography?id=eyebrow"}, "_css_classes": "g-eyebrow g-eyebrow-light"}, "elements": []}, {"id": "6619eab", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "Our mission is to help you pass on the first attempt", "header_size": "h1", "__globals__": {"title_color": "globals/colors?id=white"}, "typography_typography": "custom", "typography_font_size": {"unit": "px", "size": 56, "sizes": []}, "typography_font_size_mobile": {"unit": "px", "size": 36, "sizes": []}, "_css_classes": "g-ph1"}, "elements": []}, {"id": "041dcd2", "elType": "widget", "widgetType": "text-editor", "isInner": false, "settings": {"editor": "<p>First and foremost, our mission is to help you pass the State of Georgia license exam for the Conditioned Air license (formerly the Warm Air or HVAC license) on the first attempt.</p>", "__globals__": {"typography_typography": "globals/typography?id=lead", "text_color": "globals/colors?id=line"}, "_css_classes": "g-plead"}, "elements": []}]}]}, {"id": "09fbe24", "elType": "container", "isInner": false, "settings": {"content_width": "boxed", "flex_direction": "column", "flex_gap": {"column": "40", "row": "40", "isLinked": true, "unit": "px", "size": 40}, "padding": {"unit": "px", "top": "104", "right": "64", "bottom": "104", "left": "64", "isLinked": false}, "boxed_width": {"unit": "px", "size": 1312, "sizes": []}, "flex_gap_mobile": {"column": "28", "row": "28", "isLinked": true, "unit": "px", "size": 28}, "padding_tablet": {"unit": "px", "top": "80", "right": "40", "bottom": "80", "left": "40", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "64", "right": "20", "bottom": "64", "left": "20", "isLinked": false}, "html_tag": "section"}, "elements": [{"id": "794596b", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "80", "row": "80", "isLinked": true, "unit": "px", "size": 80}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap_tablet": {"column": "48", "row": "48", "isLinked": true, "unit": "px", "size": 48}, "flex_gap_mobile": {"column": "40", "row": "40", "isLinked": true, "unit": "px", "size": 40}, "css_classes": "g-instr g-about-top"}, "elements": [{"id": "587d892", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "20", "row": "20", "isLinked": true, "unit": "px", "size": 20}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "e8664ae", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "What sets us apart", "header_size": "h2", "__globals__": {"title_color": "globals/colors?id=navy", "typography_typography": "globals/typography?id=h2"}}, "elements": []}, {"id": "6a6c9d4", "elType": "widget", "widgetType": "html", "isInner": false, "settings": {"html": "<ul class=\"g-tick\"><li><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>Garrison Michael, our instructor, is uniquely qualified by his knowledge and experience.</li><li><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>Our detailed presentation of the materials.</li><li><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>Our ability to take complicated subjects and present them in a simplified way.</li><li><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>Our diligence in making sure you understand the concepts presented.</li><li><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>Our desire to keep our approach simple and easy to navigate.</li><li><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>Our open door policy: we want to hear your suggestions and evaluations.</li><li><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>Our desire to be available when you have questions or need support.</li><li><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>To be the best we can be for our online HVAC design and exam prep review classes.</li></ul>"}, "elements": []}]}, {"id": "195ff63", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "0", "row": "0", "isLinked": true, "unit": "px", "size": 0}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "css_classes": "g-instr-media g-about-photo"}, "elements": [{"id": "f5f1052", "elType": "widget", "widgetType": "image", "isInner": false, "settings": {"image": {"url": "https://staging158.dreamweb.digital/wp-content/uploads/2026/11/garrison.webp", "id": 536, "size": "", "alt": "", "source": "library"}, "image_size": "full", "align": "left", "_css_classes": "g-img"}, "elements": []}, {"id": "2d5974e", "elType": "widget", "widgetType": "html", "isInner": false, "settings": {"html": "<div class=\"g-badge20\" aria-hidden=\"true\"><b>20</b><span>years<br>2006\u20132026</span></div>", "_css_classes": "g-media-deco"}, "elements": []}]}]}]}, {"id": "6cb5628", "elType": "container", "isInner": false, "settings": {"content_width": "boxed", "flex_direction": "column", "flex_gap": {"column": "40", "row": "40", "isLinked": true, "unit": "px", "size": 40}, "padding": {"unit": "px", "top": "104", "right": "64", "bottom": "104", "left": "64", "isLinked": false}, "boxed_width": {"unit": "px", "size": 1312, "sizes": []}, "flex_gap_mobile": {"column": "28", "row": "28", "isLinked": true, "unit": "px", "size": 28}, "padding_tablet": {"unit": "px", "top": "80", "right": "40", "bottom": "80", "left": "40", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "64", "right": "20", "bottom": "64", "left": "20", "isLinked": false}, "background_background": "classic", "__globals__": {"background_color": "globals/colors?id=mist"}, "html_tag": "section"}, "elements": [{"id": "d3a5621", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "14", "row": "14", "isLinked": true, "unit": "px", "size": 14}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "78cfe94", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "Company history", "header_size": "div", "__globals__": {"title_color": "globals/colors?id=blue", "typography_typography": "globals/typography?id=eyebrow"}, "_css_classes": "g-eyebrow"}, "elements": []}, {"id": "b3c33a2", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "Twenty years of Georgia HVAC licensing", "header_size": "h2", "__globals__": {"title_color": "globals/colors?id=navy", "typography_typography": "globals/typography?id=h2"}}, "elements": []}]}, {"id": "a574fb7", "elType": "widget", "widgetType": "html", "isInner": false, "settings": {"html": "<ol class=\"g-timeline\"><li><span class=\"g-timeline__y\">2006</span><div><h3>GLEC is founded</h3><p>Garrison Michael founded Georgia License Exam Company in late 2006, starting with Conditioned Air license exam prep review classes and heat loss/gain and duct design classes. GLEC grew quickly through referrals.</p></div></li><li><span class=\"g-timeline__y\">2009</span><div><h3>Atlanta, Buckhead</h3><p>Classes move to a larger hotel in Atlanta, Buckhead.</p></div></li><li><span class=\"g-timeline__y\">2010</span><div><h3>Middle Georgia</h3><p>GLEC expands to Middle Georgia in February 2010 at a hotel in Warner Robins, moving to Macon a year later. We had 16 students in our first class.</p></div></li><li><span class=\"g-timeline__y\">2011</span><div><h3>Augusta and LaGrange</h3><p>Classes start in Augusta in June 2011, bringing students from across the border in South Carolina, and in LaGrange, bringing students from Eastern Alabama.</p></div></li><li><span class=\"g-timeline__y\">2013</span><div><h3>Savannah</h3><p>Our first Savannah class begins in January 2013, with more students from South Carolina.</p></div></li><li><span class=\"g-timeline__y\">2015</span><div><h3>Hybrid and online classes</h3><p>The Conditioned Air exam prep review class becomes a hybrid class in January 2015, and the Commercial Design class moves fully online in February 2015.</p></div></li><li><span class=\"g-timeline__y\">2016</span><div><h3>CEU classes</h3><p>In March 2016 we begin teaching continuing education (CEU) classes for HVAC licensed contractors, online only from the start.</p></div></li><li><span class=\"g-timeline__y\">2018</span><div><h3>Residential Design online</h3><p>In March 2018 we start offering the Residential Design class as a hybrid class (HLG-DD-R-HY) and fully online (HLG-DD-R-OL), as more students join from other states and nationwide companies.</p></div></li><li><span class=\"g-timeline__y\">2020</span><div><h3>Fully online exam prep</h3><p>Classes keep going through Covid, with most students choosing online. The CA-OL exam prep review class goes fully online in May 2020.</p></div></li><li><span class=\"g-timeline__y\">2024</span><div><h3>Online becomes the norm</h3><p>With classroom attendance down to 2 or 3 students, we close the physical classroom classes after July 2024. Our exam pass rate is still 82%.</p></div></li><li><span class=\"g-timeline__y\">2026</span><div><h3>20th anniversary</h3><p>October 2026 marks our 20th anniversary.</p></div></li></ol>"}, "elements": []}]}, {"id": "289a9ae", "elType": "container", "isInner": false, "settings": {"content_width": "boxed", "flex_direction": "column", "flex_gap": {"column": "40", "row": "40", "isLinked": true, "unit": "px", "size": 40}, "padding": {"unit": "px", "top": "104", "right": "64", "bottom": "104", "left": "64", "isLinked": false}, "boxed_width": {"unit": "px", "size": 1312, "sizes": []}, "flex_gap_mobile": {"column": "28", "row": "28", "isLinked": true, "unit": "px", "size": 28}, "padding_tablet": {"unit": "px", "top": "80", "right": "40", "bottom": "80", "left": "40", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "64", "right": "20", "bottom": "64", "left": "20", "isLinked": false}, "html_tag": "section"}, "elements": [{"id": "41789e6", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "64", "row": "64", "isLinked": true, "unit": "px", "size": 64}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap_tablet": {"column": "40", "row": "40", "isLinked": true, "unit": "px", "size": 40}, "flex_gap_mobile": {"column": "32", "row": "32", "isLinked": true, "unit": "px", "size": 32}, "css_classes": "g-twocol g-twocol--even"}, "elements": [{"id": "9325ad1", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "16", "row": "16", "isLinked": true, "unit": "px", "size": 16}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "781775d", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "Meet your instructor", "header_size": "div", "__globals__": {"title_color": "globals/colors?id=blue", "typography_typography": "globals/typography?id=eyebrow"}, "_css_classes": "g-eyebrow"}, "elements": []}, {"id": "e9b7527", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "Garrison Michael", "header_size": "h2", "__globals__": {"title_color": "globals/colors?id=navy", "typography_typography": "globals/typography?id=h2"}}, "elements": []}, {"id": "f9ca35b", "elType": "widget", "widgetType": "text-editor", "isInner": false, "settings": {"editor": "<p>Garrison Michael was born and raised in Chicago, Illinois. He has over 34 years of experience in HVAC, and in the last 11 years, experience with low voltage systems for the large commercial and industrial markets.</p><p>He graduated in 1981 from the Milwaukee School of Engineering with a B.S. in Building Construction Engineering. He started at MCC Powers (now Siemens Building Technologies) as an application engineer designing building automation system layouts. In 1986 he joined Johnson Controls as a project engineer, working on large projects like the new Fulton County Jail and the new Coca-Cola USA Tower and Reception Center. He was project manager on three new state prisons and two county jails, with fire alarm, security, card access, public address, intercom, closed circuit TV, television signal distribution, and programmable logic controller systems for the cell doors.</p><p>In 1992 Garrison began a 14-plus year career at Georgia Trane as a sales engineer for the service company, selling service agreements to building owners to maintain and expand their BAS and HVAC systems, and delivering turnkey HVAC systems. In 2003 he also began teaching at the Georgia Trane Training Center. He created the Low Voltage license exam prep review class, and two years later began teaching Conditioned Air (HVAC) classes, including the design classes and the Conditioned Air license exam prep review classes.</p><p>When Garrison resigned in 2006, he started Georgia License Exam Company.</p>", "__globals__": {"typography_typography": "globals/typography?id=body", "text_color": "globals/colors?id=ink"}, "_css_classes": "g-prose "}, "elements": []}]}, {"id": "d6acb48", "elType": "widget", "widgetType": "html", "isInner": false, "settings": {"html": "<figure class=\"g-bigquote\"><span class=\"g-qmark\" aria-hidden=\"true\">\u201c</span><blockquote>I love to help others succeed in achieving their life vision, which in turn should help one attain their own dreams. I believe with my analytical engineering background, my real onsite construction experience, and my years at Trane, that I have this unique ability to take a complex analytical concept, re-shuffle it, and present it in a practical useful way, to help students feel confident about themselves and reach their goal of passing the state exams.</blockquote><figcaption>Garrison Michael</figcaption></figure>"}, "elements": []}]}]}, {"id": "2535f55", "elType": "container", "isInner": false, "settings": {"content_width": "boxed", "flex_direction": "column", "flex_gap": {"column": "40", "row": "40", "isLinked": true, "unit": "px", "size": 40}, "padding": {"unit": "px", "top": "104", "right": "64", "bottom": "104", "left": "64", "isLinked": false}, "boxed_width": {"unit": "px", "size": 1312, "sizes": []}, "flex_gap_mobile": {"column": "28", "row": "28", "isLinked": true, "unit": "px", "size": 28}, "padding_tablet": {"unit": "px", "top": "80", "right": "40", "bottom": "80", "left": "40", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "64", "right": "20", "bottom": "64", "left": "20", "isLinked": false}, "background_background": "classic", "__globals__": {"background_color": "globals/colors?id=mist"}, "html_tag": "section"}, "elements": [{"id": "c0063a0", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "24", "row": "24", "isLinked": true, "unit": "px", "size": 24}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap_mobile": {"column": "16", "row": "16", "isLinked": true, "unit": "px", "size": 16}, "css_classes": "g-twocol g-twocol--even"}, "elements": [{"id": "7cbf1af", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "16", "row": "16", "isLinked": true, "unit": "px", "size": 16}, "padding": {"unit": "px", "top": "32", "right": "32", "bottom": "32", "left": "32", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "24", "right": "20", "bottom": "24", "left": "20", "isLinked": false}, "css_classes": "g-card g-card--flat"}, "elements": [{"id": "02e3d8c", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "Licenses and certifications", "header_size": "h3", "__globals__": {"title_color": "globals/colors?id=navy"}, "typography_typography": "custom", "typography_font_size": {"unit": "px", "size": 24, "sizes": []}}, "elements": []}, {"id": "a77d83e", "elType": "widget", "widgetType": "html", "isInner": false, "settings": {"html": "<ul class=\"g-list g-list--cols\"><li>Conditioned Air Contractors Non-Restricted License, State of Georgia</li><li>Heating &amp; Air Conditioning Contractor, State of Alabama</li><li>Commercial Mechanical Contractor License, State of Tennessee</li><li>Conditioned Air Contractor &ldquo;Air B&rdquo; License, State of Florida</li><li>Mechanical, Air Conditioning License, State of South Carolina</li><li>Air Conditioning License &ldquo;A&rdquo;, State of Texas</li><li>Low Voltage Contractors Universal License, State of Georgia</li><li>EPA Sections 608 and 609 Technician Certification for refrigerant handling</li><li>R410A Refrigerant Safety Certification</li><li>Green Building: LEED&reg; 2.0 Accredited Professional</li><li>EPA Renovator Certification</li><li>DET (Duct &amp; Envelope Tightness) Certification</li></ul>"}, "elements": []}]}, {"id": "d47aca9", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "24", "row": "24", "isLinked": true, "unit": "px", "size": 24}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "a08e34e", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "16", "row": "16", "isLinked": true, "unit": "px", "size": 16}, "padding": {"unit": "px", "top": "32", "right": "32", "bottom": "32", "left": "32", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "24", "right": "20", "bottom": "24", "left": "20", "isLinked": false}, "css_classes": "g-card g-card--flat"}, "elements": [{"id": "7536bb2", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "Education", "header_size": "h3", "__globals__": {"title_color": "globals/colors?id=navy"}, "typography_typography": "custom", "typography_font_size": {"unit": "px", "size": 24, "sizes": []}}, "elements": []}, {"id": "1cfbf0c", "elType": "widget", "widgetType": "html", "isInner": false, "settings": {"html": "<ul class=\"g-list\"><li>B.S. in Building Construction Engineering, Milwaukee School of Engineering</li><li>One year in the M.B.A. program, Georgia College, Milledgeville, Georgia</li><li>LifeWorks&reg; School of Coaching: Certified Life Coach</li></ul>"}, "elements": []}]}, {"id": "6b7b853", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "16", "row": "16", "isLinked": true, "unit": "px", "size": 16}, "padding": {"unit": "px", "top": "32", "right": "32", "bottom": "32", "left": "32", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "24", "right": "20", "bottom": "24", "left": "20", "isLinked": false}, "css_classes": "g-card g-card--flat"}, "elements": [{"id": "749f152", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "Trane training", "header_size": "h3", "__globals__": {"title_color": "globals/colors?id=navy"}, "typography_typography": "custom", "typography_font_size": {"unit": "px", "size": 24, "sizes": []}}, "elements": []}, {"id": "450e0ff", "elType": "widget", "widgetType": "html", "isInner": false, "settings": {"html": "<ul class=\"g-list\"><li>Trane Counselor Sales Training 1 and 2, LaCrosse, WI</li><li>Trane Performance Contracting Training (PACT), St. Paul, WI</li><li>Trane: Sandler Sales Training</li><li>National Association of Trane Franchise Convention, attendee for several years</li></ul>"}, "elements": []}]}]}]}]}], "page_settings": {"hide_title": "yes"}, "version": "0.4", "title": "About", "type": "page"}