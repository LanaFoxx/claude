{"title": "Technician certifications", "header_size": "h1", "__globals__": {"title_color": "globals/colors?id=white"}, "typography_typography": "custom", "typography_font_size": {"unit": "px", "size": 56, "sizes": []}, "typography_font_size_mobile": {"unit": "px", "size": 36, "sizes": []}, "_css_classes": "g-ph1"}, "elements": []}, {"id": "1781e68", "elType": "widget", "widgetType": "text-editor", "isInner": false, "settings": {"editor": "<p>For students who want NATE and/or EPA-608 technician certification. EPA-608 Type 2 or higher is required for your Conditioned Air license application.</p>", "__globals__": {"typography_typography": "globals/typography?id=lead", "text_color": "globals/colors?id=line"}, "_css_classes": "g-plead"}, "elements": []}]}]}, {"id": "bc77458", "elType": "container", "isInner": false, "settings": {"content_width": "boxed", "flex_direction": "column", "flex_gap": {"column": "40", "row": "40", "isLinked": true, "unit": "px", "size": 40}, "padding": {"unit": "px", "top": "104", "right": "64", "bottom": "104", "left": "64", "isLinked": false}, "boxed_width": {"unit": "px", "size": 1312, "sizes": []}, "flex_gap_mobile": {"column": "28", "row": "28", "isLinked": true, "unit": "px", "size": 28}, "padding_tablet": {"unit": "px", "top": "80", "right": "40", "bottom": "80", "left": "40", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "64", "right": "20", "bottom": "64", "left": "20", "isLinked": false}, "html_tag": "section"}, "elements": [{"id": "a09c2f9", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "64", "row": "64", "isLinked": true, "unit": "px", "size": 64}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "flex_gap_mobile": {"column": "32", "row": "32", "isLinked": true, "unit": "px", "size": 32}, "css_classes": "g-twocol g-twocol--even"}, "elements": [{"id": "86aae9a", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "16", "row": "16", "isLinked": true, "unit": "px", "size": 16}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "b5e5523", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "Testing online", "header_size": "h2", "__globals__": {"title_color": "globals/colors?id=navy", "typography_typography": "globals/typography?id=h2"}}, "elements": []}, {"id": "29bf7ad", "elType": "widget", "widgetType": "text-editor", "isInner": false, "settings": {"editor": "<p>GLEC no longer provides testing for EPA-608 and NATE certifications.</p><ul class=\"g-list\"><li>NATE has hired a company to provide remote monitoring of online testing for both NATE and EPA-608.</li><li>You can take the test from any computer at home or work.</li><li>It is also cheaper this way.</li><li>You can schedule a test whenever you like.</li><li>NATE has study materials to prep you for the test, and there are other test preps online.</li></ul><p><a href=\"https://www.natex.org\" target=\"_blank\" rel=\"noopener\">Go to the NATE website, natex.org</a></p>", "__globals__": {"typography_typography": "globals/typography?id=body", "text_color": "globals/colors?id=ink"}, "_css_classes": "g-prose "}, "elements": []}]}, {"id": "ac57adb", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "16", "row": "16", "isLinked": true, "unit": "px", "size": 16}, "padding": {"unit": "px", "top": "32", "right": "32", "bottom": "32", "left": "32", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "24", "right": "20", "bottom": "24", "left": "20", "isLinked": false}, "css_classes": "g-card g-card--flat"}, "elements": [{"id": "92a4e03", "elType": "widget", "widgetType": "heading", "isInner": false, "settings": {"title": "Paper testing for EPA-608 in Atlanta", "header_size": "h2", "__globals__": {"title_color": "globals/colors?id=navy", "typography_typography": "globals/typography?id=h2"}}, "elements": []}, {"id": "29a1c9c", "elType": "widget", "widgetType": "text-editor", "isInner": false, "settings": {"editor": "<ul class=\"g-list\"><li>Call Stan Smith at <a href=\"tel:+14043911159\">(404) 391-1159</a>.</li><li>Mingledorff&rsquo;s, Johnstone Supply and Baker Distributing (HVAC parts stores) may still offer EPA-608 testing.</li><li><a href=\"https://www.skillcatapp.com\" target=\"_blank\" rel=\"noopener\">SkillCat (skillcatapp.com)</a> offers several EPA-608 certifications for the trades.</li></ul>", "__globals__": {"typography_typography": "globals/typography?id=body", "text_color": "globals/colors?id=ink"}, "_css_classes": "g-prose "}, "elements": []}]}]}]}]}